---
const year = new Date().getFullYear();
---
<style>
  @keyframes vec-spin     { from { transform: rotate(0deg); }  to { transform: rotate(360deg); } }
  @keyframes vec-spin-rev { from { transform: rotate(0deg); }  to { transform: rotate(-360deg); } }
  @keyframes vec-float-rev {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50%      { transform: translateY(20px) rotate(-4deg); }
  }
</style>
<footer class="bg-forest-dark text-cream/70 relative overflow-hidden">

  <!-- Decoraciones vectoriales de fondo -->
  <div class="absolute -left-24 top-0 w-72 h-72 pointer-events-none select-none opacity-[0.05]"
       style="animation: vec-spin 70s linear infinite;" aria-hidden="true">
    <img loading="lazy" decoding="async" src="/svg/oval.svg" alt="" class="w-full h-full brightness-200" />
  </div>
  <div class="absolute -right-16 bottom-0 w-80 h-96 pointer-events-none select-none opacity-[0.04]"
       style="animation: vec-float-rev 16s ease-in-out infinite;" aria-hidden="true">
    <img loading="lazy" decoding="async" src="/svg/coffee.svg" alt="" class="w-full h-full brightness-200" />
  </div>
  <div class="absolute right-1/3 top-1/2 -translate-y-1/2 w-48 h-48 pointer-events-none select-none opacity-[0.04]"
       style="animation: vec-spin-rev 50s linear infinite;" aria-hidden="true">
    <img loading="lazy" decoding="async" src="/svg/oval-alt.svg" alt="" class="w-full h-full brightness-200" />
  </div>

  <!-- Gold rule top -->
  <div class="h-px bg-gradient-to-r from-transparent via-gold/40 to-transparent"></div>

  <div class="max-w-7xl mx-auto px-6 lg:px-12 py-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">

    <!-- Brand -->
    <div class="lg:col-span-2">
      <a href="/" class="inline-flex items-center gap-3 mb-5 group">
        <img loading="lazy" decoding="async"
          src="/img/logos_varios/logo-cohonducafe-blanco-240.webp" width="240" height="194"
          alt="COHONDUCAFE"
          class="h-9 w-auto object-contain opacity-80 group-hover:opacity-100 transition-opacity duration-300"
        />
      </a>
      <p data-i18n="footer.tagline" class="text-sm leading-relaxed max-w-xs mt-4 mb-6">
        Más de 70 años cultivando café hondureño de calidad, impulsando comunidades y exportando al mundo.
      </p>

      <!-- Certificaciones mini -->
      <div class="flex flex-wrap gap-2">
        {['USDA Organic', 'Rainforest', 'Fairtrade'].map(cert => (
          <span class="text-xs font-bold tracking-widest uppercase border border-white/15 text-white/70 px-2.5 py-1">
            {cert}
          </span>
        ))}
      </div>
    </div>

    <!-- Navegación -->
    <div>
      <h4 data-i18n="footer.nav.title" class="text-white font-semibold text-xs tracking-[0.25em] uppercase mb-6">Navegación</h4>
      <ul class="space-y-3 text-sm">
        {[
          { href: '/',          key: 'nav.home',    label: 'Inicio'   },
          { href: '/nosotros',  key: 'nav.about',   label: 'Nosotros' },
          { href: '/marcas',          key: 'nav.brands',  label: 'Marcas'          },
          { href: '/junta-directiva', key: 'nav.board',   label: 'Junta Directiva' },
          { href: '/contacto',        key: 'nav.contact', label: 'Contacto'        },
        ].map(link => (
          <li>
            <a href={link.href} data-i18n={link.key} class="hover:text-gold hover:translate-x-1 inline-block transition-all duration-200">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Contacto -->
    <div>
      <h4 data-i18n="footer.con.title" class="text-white font-semibold text-xs tracking-[0.25em] uppercase mb-6">Contacto</h4>
      <ul class="space-y-4 text-sm">
        <li class="flex items-start gap-2.5">
          <svg class="w-4 h-4 mt-0.5 text-gold shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <span data-i18n="footer.con.loc">Honduras, Centroamérica</span>
        </li>
        <li class="flex items-start gap-2.5">
          <svg class="w-4 h-4 mt-0.5 text-gold shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          <a href="mailto:info@honducafeproyectos.com" class="min-w-0 hover:text-gold transition-colors duration-200">
            info@<wbr />honducafeproyectos.com
          </a>
        </li>
      </ul>

      <!-- CTA pequeño -->
      <a href="/contacto" data-i18n="footer.cta" class="inline-block mt-8 text-xs font-bold tracking-[0.25em] uppercase border border-gold/40 text-gold px-5 py-2.5 hover:bg-gold hover:text-white hover:border-gold transition-colors duration-200">
        Escríbenos →
      </a>
    </div>

  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/8 max-w-7xl mx-auto px-6 lg:px-12 py-6 flex flex-col sm:flex-row justify-between items-center gap-3 text-xs text-cream/70">
    <span>&copy; {year} COHONDUCAFE. Todos los derechos reservados.</span>
    <span class="flex items-center gap-1.5">
      <span class="w-1 h-1 rounded-full bg-gold/50"></span>
      <span data-i18n="footer.since">Honduras · Desde 1954</span>
    </span>
  </div>

</footer>
