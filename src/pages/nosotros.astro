---
import Layout from '../layouts/Layout.astro';

const hitos = [
  { year: '1954', evento: 'Se establece la 1ª finca de café en Yoro. Nace una tradición familiar 100% hondureña.' },
  { year: '1976', evento: 'Comenzó la producción y el comercio de café a nivel nacional.' },
  { year: '1999', evento: 'Inicio de las exportaciones de café al mercado internacional.' },
  { year: '2010', evento: 'Se convirtió en el mayor exportador de café de Honduras y Centroamérica.' },
  { year: '2012', evento: 'Galardonado con los premios presidenciales al Mejor Exportador y al Exportador de Comercio Justo.' },
  { year: '2013', evento: 'Se creó la Fundación COHONDUCAFE para formalizar la responsabilidad social.' },
  { year: '2017', evento: 'Récord histórico: 2.8 millones de sacos de café verde exportados.' },
  { year: '2022', evento: 'Se exportó alrededor del 30% de la producción total de café de Honduras.' },
  { year: '2023', evento: 'Inauguración de una nueva planta de procesamiento para cafés especiales.' },
  { year: '2024', evento: 'Más de 20,000 productores recibieron asistencia en agricultura regenerativa y georreferenciada (EUDR).' },
];

const infraestructura = [
  {
    num: '30–36', label: 'Lotes / día', sub: '15,000 sacos de 46 kg c/u',
    iconPath: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4',
  },
  {
    num: '1M', label: 'Sacos almacenados', sub: 'Capacidad de café verde',
    iconPath: 'M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4',
  },
  {
    num: '3', label: 'Plantas de producción', sub: '30% de la producción nacional',
    iconPath: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
  },
  {
    num: '40,000+', label: 'Familias productoras', sub: 'Trabajo directo',
    iconPath: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
  },
];

const impacto = [
  {
    titulo: '+40,000 familias',
    desc: 'Trabajo directo con familias productoras de café en Honduras.',
    icon: `<svg width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
  },
  {
    titulo: '+200,000 personas',
    desc: 'Con bajos ingresos en regiones remotas beneficiadas por nuestros programas.',
    icon: `<svg width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.3" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path stroke-linecap="round" stroke-linejoin="round" d="M2 12h20M12 2a15.3 15.3 0 010 20M12 2a15.3 15.3 0 000 20"/></svg>`,
  },
  {
    titulo: 'Prácticas sostenibles',
    desc: 'Promoción de agricultura regenerativa para aumentar productividad por hectárea.',
    icon: `<svg width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2C6 2 3 7 3 11c0 6 9 11 9 11s9-5 9-11c0-4-3-9-9-9z"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 2c0 0 5 6 0 11"/></svg>`,
  },
  {
    titulo: 'Comunidades rurales',
    desc: 'Mejoramiento de condiciones de vida e ingresos en zonas cafetaleras.',
    icon: `<svg width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>`,
  },
];

const certificaciones = [
  { nombre: 'USDA Organic',        color: 'border border-coffee/30 text-coffee bg-coffee/5' },
  { nombre: 'EU Organic',          color: 'border border-coffee/30 text-coffee bg-coffee/5' },
  { nombre: '4C',                  color: 'border border-gold/40 text-coffee bg-gold/8' },
  { nombre: 'Rainforest Alliance', color: 'border border-coffee/30 text-coffee bg-coffee/5' },
  { nombre: 'Fairtrade',           color: 'border border-earth/35 text-earth bg-earth/8' },
];

const regiones = ['Santa Bárbara', 'El Paraíso', 'Lempira', 'Intibucá', 'Yoro', 'Ocotepeque', 'Copán', 'Olancho', 'Francisco Morazán', 'Comayagua', 'La Paz', 'Cortés'];

const directivos = [
  {
    gen: '1ra Generación',
    sub: 'Los fundadores',
    miembros: [
      { nombre: 'Nicholas Hawit Badour', cargo: 'Emigró de Jerusalem en la década de 1920' },
      { nombre: 'Basilio Fuschich Packran', cargo: 'Emigró de Czechoslovakia en 1927' },
    ]
  },
  {
    gen: '2da Generación',
    sub: 'Liderazgo actual',
    miembros: [
      { nombre: 'Basilio Fuschich', cargo: 'Presidente' },
      { nombre: 'Suyapa Hawit-Fuschich', cargo: 'Vice Presidenta' },
    ]
  },
  {
    gen: '3ra Generación',
    sub: 'Dirección ejecutiva',
    miembros: [
      { nombre: 'Basilio Fuschich', cargo: 'CEO COHONDUCAFE' },
      { nombre: 'Terence Fuschich', cargo: 'Gerente de Operaciones · Experto en Catación Q Grader' },
      { nombre: 'Rommel Fuschich', cargo: 'Gerente de Recursos Humanos · Presidente Fundación COHONDUCAFE' },
    ]
  },
  {
    gen: '4ta Generación',
    sub: 'Nueva generación',
    miembros: [
      { nombre: 'Basilio Fuschich', cargo: 'Comercialización de Café' },
      { nombre: 'Christopher Fuschich', cargo: 'Control de Calidad' },
      { nombre: 'Samuel Bendeck', cargo: 'Comercialización de Café y Departamento Financiero' },
    ]
  },
];
---

<Layout title="Nosotros" description="COHONDUCAFE — Una tradición familiar desde 1954. Mayor exportador de café de Honduras y Centroamérica.">

  <!-- PAGE HEADER -->
  <section class="relative h-96 flex items-end overflow-hidden">
    <img src="/img/Nosotros/BannerPrincipal/Familia.webp" alt="COHONDUCAFE" class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-t from-forest-dark via-forest-dark/60 to-transparent"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-12 pb-14 w-full">
      <p data-i18n="nos.header.label" class="section-label mb-2">Una tradición familiar desde 1954</p>
      <h1 data-i18n="nos.header.h1" class="font-display text-5xl md:text-6xl font-bold text-white">100% Hondureña</h1>
    </div>
  </section>

  <!-- ─── NUESTRA EMPRESA ──────────────────────────────────────────── -->
  <section class="py-24 bg-cream-light">
    <div class="max-w-7xl mx-auto px-6 lg:px-12 grid lg:grid-cols-2 gap-16 items-center">
      <div>
        <p data-i18n="nos.qs.label" class="section-label mb-4 reveal">Nuestra empresa</p>
        <h2 class="font-display text-4xl font-bold text-coffee-dark leading-tight mb-6 reveal">
          <span data-i18n="nos.qs.h2a">Referente mundial en</span><br/><span data-i18n="nos.qs.h2b" class="italic text-coffee">café de alta calidad</span>
        </h2>
        <p data-i18n="nos.qs.p1" class="text-coffee/70 leading-relaxed mb-5 reveal">
          COHONDUCAFE es una empresa que se destaca como referente en el comercio y la exportación mundial de café en grano de alta calidad en Honduras. Nos esforzamos por superar las expectativas y satisfacer las necesidades de nuestros clientes en todo el mundo, cumpliendo con las metas y objetivos organizacionales establecidos.
        </p>
        <p data-i18n="nos.qs.p2" class="text-coffee/70 leading-relaxed mb-8 reveal">
          La historia comenzó con dos familias inmigrantes: Nicholas Hawit Badour, quien llegó de Jerusalem en la década de 1920, y Basilio Fuschich Packran, que emigró de Czechoslovakia en 1927. Sus hijos, Basilio Fuschich y Suyapa Hawit-Fuschich, fundaron la empresa en 1954. Hoy, cuatro generaciones después, sus descendientes continúan liderándola con la misma pasión y compromiso.
        </p>
        <div class="flex flex-wrap gap-3 reveal">
          {certificaciones.map(c => (
            <span class={`text-xs font-bold tracking-wider uppercase px-3 py-1.5 rounded-full ${c.color}`}>{c.nombre}</span>
          ))}
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4 reveal">
        <img loading="lazy" decoding="async" src="/img/Nosotros/referentemundial/isa_1.webp" alt="Café COHONDUCAFE" class="h-64 w-full object-cover" />
        <img loading="lazy" decoding="async" src="/img/Nosotros/referentemundial/isa_2.webp" alt="Comunidad" class="h-64 w-full object-cover" />
        <img loading="lazy" decoding="async" src="/img/Nosotros/referentemundial/isa_3.webp" alt="Producción" class="h-64 w-full object-cover col-span-2 object-center" />
      </div>
    </div>
  </section>

  <!-- ─── CIFRAS CLAVE ───────────────────────────────────────────── -->
  <section id="cifras" class="relative overflow-hidden bg-[#1C0E08]">

    <!-- Textura grain -->
    <div class="absolute inset-0 bg-grain opacity-40 pointer-events-none"></div>

    <!-- Watermark año -->
    <span class="absolute font-display font-bold select-none pointer-events-none leading-none"
          aria-hidden="true"
          style="font-size:28vw; right:-1vw; top:50%; transform:translateY(-52%); color:rgba(196,154,60,0.042)">
      1954
    </span>

    <!-- Regla dorada superior -->
    <div class="relative z-10 h-px bg-gradient-to-r from-transparent via-gold/45 to-transparent"></div>

    <!-- Grid de cifras -->
    <div class="relative z-10 max-w-7xl mx-auto">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-y divide-gold/10 sm:divide-y-0 sm:divide-x lg:divide-y-0">
        {infraestructura.map((item, i) => (
          <div class="cifra-card group relative px-8 py-20 text-center hover:bg-white/[0.03] transition-colors duration-300">

            <!-- Línea de acento en hover -->
            <div class="absolute top-0 inset-x-8 h-px bg-gold/50 origin-center scale-x-0 group-hover:scale-x-100 transition-transform duration-500 ease-out"></div>

            <!-- Ícono -->
            <div class="flex justify-center mb-7">
              <div class="w-10 h-10 rounded-full border border-gold/20 flex items-center justify-center group-hover:border-gold/50 transition-colors duration-300">
                <svg class="w-4 h-4 text-gold/60 group-hover:text-gold/90 transition-colors duration-300"
                     fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d={item.iconPath}/>
                </svg>
              </div>
            </div>

            <!-- Número -->
            <div class="cifra-num font-display font-bold text-gold leading-none mb-4"
                 style={`font-size:clamp(2.6rem,3.8vw,3.8rem)`}>
              {item.num}
            </div>

            <!-- Etiqueta -->
            <div data-i18n={`nos.cifras.i${i}.lbl`} class="text-[9.5px] text-cream font-bold tracking-[0.42em] uppercase mb-3">
              {item.label}
            </div>

            <!-- Separador puntual -->
            <div class="flex items-center justify-center gap-1.5 mb-3">
              <div class="w-3 h-px bg-gold/25"></div>
              <div class="w-1 h-1 rounded-full bg-gold/35"></div>
              <div class="w-3 h-px bg-gold/25"></div>
            </div>

            <!-- Sub texto -->
            <div data-i18n={`nos.cifras.i${i}.sub`} class="text-cream/35 text-[11px] font-medium tracking-wide">
              {item.sub}
            </div>

          </div>
        ))}
      </div>
    </div>

    <!-- Regla dorada inferior -->
    <div class="relative z-10 h-px bg-gradient-to-r from-transparent via-gold/45 to-transparent"></div>

  </section>

  <script is:inline>
  (function () {
    var section = document.getElementById('cifras');
    if (!section) return;
    var fired = false;
    var CHARS = '0123456789';

    function scramble(el, delay) {
      var target = el.textContent.trim();
      setTimeout(function () {
        var frame = 0, total = 24;
        var id = setInterval(function () {
          el.textContent = target.split('').map(function (ch, ci) {
            if (!/\d/.test(ch)) return ch;
            if (frame >= total - ci * 2.5) return ch;
            return CHARS[Math.floor(Math.random() * CHARS.length)];
          }).join('');
          if (++frame > total) { clearInterval(id); el.textContent = target; }
        }, 42);
      }, delay);
    }

    new IntersectionObserver(function (entries) {
      if (fired || !entries[0].isIntersecting) return;
      fired = true;
      section.querySelectorAll('.cifra-num').forEach(function (el, i) {
        scramble(el, i * 140);
      });
    }, { threshold: 0.3 }).observe(section);
  })();
  </script>

  <!-- ─── TIMELINE HORIZONTAL INTERACTIVO ────────────────────── -->
  <section class="htl-section">


    <div class="max-w-[1380px] mx-auto px-8 lg:px-16 relative z-10">

      <!-- Cabecera + navegación -->
      <div class="flex items-end justify-between mb-14">
        <div>
          <p data-i18n="nos.tl.label" class="section-label mb-3 reveal">Nuestra trayectoria</p>
          <h2 class="font-display text-4xl font-bold text-coffee-dark reveal"><span data-i18n="nos.tl.h2a">Hitos de</span> <span data-i18n="nos.tl.h2b">nuestra historia</span></h2>
        </div>
        <div class="flex gap-3 reveal">
          <button id="htl-prev" aria-label="Anterior" data-i18n-aria="a11y.prev"
            class="htl-nav-btn">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
          </button>
          <button id="htl-next" aria-label="Siguiente" data-i18n-aria="a11y.next"
            class="htl-nav-btn">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      </div>

      <!-- Track -->
      <div class="htl is-started" id="htl">
        <div class="htl__track">
          <div class="htl__line"></div>
          <div class="htl__progress-line" id="htl-progress"></div>

          {hitos.map((h, i) => (
            <div class={`htl__item ${i % 2 === 0 ? 'htl__item--top' : 'htl__item--bot'}`}
                 style={`--i:${i}`}
                 data-index={i}
                 role="button"
                 tabindex="0"
                 aria-labelledby={`htl-y-${i} htl-t-${i}`}>
              <div class="htl__card">
                <span id={`htl-y-${i}`} class="htl__year">{h.year}</span>
                <!-- Tooltip creativo al hover -->
                <div class="htl__tooltip">
                  <div class="htl__tooltip-bean" aria-hidden="true">
                    <svg width="14" height="18" viewBox="0 0 14 18" fill="none" stroke="#C49A3C" stroke-width="1.2" stroke-linecap="round">
                      <ellipse cx="7" cy="9" rx="5.5" ry="8"/>
                      <line x1="7" y1="1.5" x2="7" y2="16.5"/>
                      <path d="M3 5.5 Q7 7.5 11 5.5"/>
                      <path d="M2.5 9 Q7 11 11.5 9"/>
                      <path d="M3 12.5 Q7 10.5 11 12.5"/>
                    </svg>
                  </div>
                  <span class="htl__tooltip-year">{h.year}</span>
                  <p id={`htl-t-${i}`} data-i18n={`nos.hito.${i}`} class="htl__tooltip-text">{h.evento}</p>
                </div>
              </div>
              <div class="htl__conn"></div>
              <div class="htl__dot">
                <span class="htl__dot-pulse"></span>
              </div>
            </div>
          ))}
        </div>

        <!-- Panel de detalle -->
        <div class="htl__detail" id="htl-detail" aria-live="polite">
          <div class="htl__detail-inner">
            <span class="htl__detail-year" id="htl-detail-year"></span>
            <p class="htl__detail-text" id="htl-detail-text"></p>
          </div>
        </div>

        <!-- Indicadores de posición -->
        <div class="htl__dots-nav" id="htl-dots-nav">
          {hitos.map((_, i) => (
            <button class="htl__nav-dot" data-nav={i} aria-label={`Ir al hito ${i + 1}`} data-i18n-aria="a11y.milestone" data-i18n-n={i + 1}></button>
          ))}
        </div>
      </div>

    </div>
  </section>

  <script is:inline>
  (function () {
    var items  = document.querySelectorAll('.htl__item');
    var detailYear = document.getElementById('htl-detail-year');
    var detailText = document.getElementById('htl-detail-text');
    var detail     = document.getElementById('htl-detail');
    var progress   = document.getElementById('htl-progress');
    var navDots    = document.querySelectorAll('.htl__nav-dot');
    var btnPrev    = document.getElementById('htl-prev');
    var btnNext    = document.getElementById('htl-next');
    var current    = -1;

    /* Se lee del DOM en cada uso para reflejar el idioma activo */
    function hito(idx) {
      return {
        year: items[idx].querySelector('.htl__year').textContent,
        text: items[idx].querySelector('.htl__tooltip-text').textContent
      };
    }

    window.addEventListener('cohonlangchange', function () {
      if (current >= 0) detailText.textContent = hito(current).text;
    });

    function activate(idx) {
      if (idx < 0 || idx >= items.length) return;

      // Desactivar anterior
      items.forEach(function(el) { el.classList.remove('htl__item--active'); });
      navDots.forEach(function(d) { d.classList.remove('is-active'); });

      // Activar nuevo
      items[idx].classList.add('htl__item--active');
      if (navDots[idx]) navDots[idx].classList.add('is-active');

      // Línea de progreso
      var pct = (idx / (items.length - 1)) * 100;
      if (progress) progress.style.transform = 'translateY(-50%) scaleX(' + (pct / 100) + ')';

      // Panel de detalle
      detail.classList.add('htl__detail--exit');
      setTimeout(function () {
        detailYear.textContent = hito(idx).year;
        detailText.textContent = hito(idx).text;
        detail.classList.remove('htl__detail--exit');
        detail.classList.add('htl__detail--visible');
      }, 180);

      current = idx;

      // Botones prev/next
      if (btnPrev) btnPrev.disabled = idx === 0;
      if (btnNext) btnNext.disabled = idx === items.length - 1;
    }

    // Click en cada hito
    items.forEach(function(el, i) {
      el.addEventListener('click',   function() { activate(i); });
      el.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') activate(i);
      });
    });

    // Dots de navegación
    navDots.forEach(function(d) {
      d.addEventListener('click', function() { activate(parseInt(d.dataset.nav)); });
    });

    // Flechas
    if (btnPrev) btnPrev.addEventListener('click', function() { activate(current - 1); });
    if (btnNext) btnNext.addEventListener('click', function() { activate(current + 1); });

    // Flechas del teclado: solo mientras la línea de tiempo está en pantalla
    var inView = false;
    document.addEventListener('keydown', function(e) {
      if (!inView) return;
      var tag = (e.target && e.target.tagName) || '';
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
      if (e.key === 'ArrowLeft')  activate(current - 1);
      if (e.key === 'ArrowRight') activate(current + 1);
    });

    // Activar el primero automáticamente al entrar en viewport
    var section = document.querySelector('.htl-section');
    if (section) {
      new IntersectionObserver(function(entries) {
        inView = entries[0].isIntersecting;
        if (inView && current === -1) { activate(0); }
      }, { threshold: 0.4 }).observe(section);
    }
  })();
  </script>

  <!-- ─── IMPACTO SOCIAL ────────────────────────────────────────── -->
  <section class="py-24 bg-forest-dark">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="text-center mb-16">
        <p data-i18n="nos.imp.label" class="section-label mb-4 reveal">Responsabilidad social</p>
        <h2 data-i18n="nos.imp.h2" class="font-display text-4xl font-bold text-white reveal">Impacto social y ambiental</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {impacto.map((item, i) => (
          <div class="bg-white/5 border border-white/10 p-8 text-center reveal hover:bg-white/10 transition-colors duration-300" style={`transition-delay:${i * 0.1}s`}>
            <div class="text-gold flex justify-center mb-5" set:html={item.icon} />
            <h3 data-i18n={`nos.imp.${i}.tit`} class="font-display text-xl font-bold text-gold mb-3">{item.titulo}</h3>
            <p data-i18n={`nos.imp.${i}.dsc`} class="text-cream/60 text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── REGIONES ──────────────────────────────────────────────── -->
  <section class="py-24 bg-coffee relative overflow-hidden">
    <div class="absolute inset-0 bg-grain opacity-30 pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-6 lg:px-12 relative z-10">

      <div class="text-center mb-12">
        <p data-i18n="nos.reg.label" class="section-label mb-4 reveal">Cobertura nacional</p>
        <h2 data-i18n="nos.reg.h2" class="font-display text-4xl font-bold text-white reveal">Regiones del café</h2>
        <p data-i18n-html="nos.reg.sub" class="text-cream/70 mt-4 reveal [&_strong]:text-white">
          Oficina principal en <strong class="text-white">San Pedro Sula</strong> · Puerto de embarque en <strong class="text-white">Puerto Cortés</strong>
        </p>
      </div>

      <!-- Grid: mapa + lista -->
      <div class="grid lg:grid-cols-2 gap-12 items-center">

        <!-- Mapa interactivo Honduras -->
        <div class="reveal">
          <div id="honduras-map" style="height:420px; width:100%;"></div>
          <!-- Leyenda -->
          <div class="flex gap-6 justify-center mt-4">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-sm inline-block bg-gold"></span>
              <span class="text-cream/60 text-xs tracking-widest uppercase font-semibold" data-i18n="nos.reg.l1">Región cafetalera</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-sm inline-block" style="background:#1A6B40"></span>
              <span class="text-cream/60 text-xs tracking-widest uppercase font-semibold" data-i18n="nos.reg.l2">Otros departamentos</span>
            </div>
          </div>
        </div>

        <!-- Lista de regiones -->
        <div class="reveal">
          <div class="grid grid-cols-2 gap-3">
            {regiones.map(r => (
              <div class="flex items-center gap-3 bg-white/8 border border-white/15 px-4 py-3 hover:bg-white/15 hover:border-gold/40 transition-all duration-200 group">
                <span class="w-1.5 h-1.5 rounded-full bg-gold shrink-0 group-hover:scale-125 transition-transform"></span>
                <span class="text-cream/85 text-sm font-medium">{r}</span>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ─── JUNTA DIRECTIVA ───────────────────────────────────────── -->
  <section class="py-24 bg-cream-light">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="text-center mb-16">
        <p data-i18n="nos.cta.label" class="section-label mb-4 reveal">Empresa familiar</p>
        <h2 data-i18n="nos.cta.h2" class="font-display text-4xl font-bold text-coffee-dark reveal">Cuatro Generaciones</h2>
        <p class="text-coffee/60 mt-4 max-w-xl mx-auto reveal">
          Desde dos familias inmigrantes en la década de 1920 hasta una empresa líder en exportación mundial de café. Un legado vivo.
        </p>
      </div>

      <!-- Línea de tiempo generacional -->
      <div class="hidden lg:flex items-center justify-between mb-12 reveal">
        {['1ra', '2da', '3ra', '4ta'].map((g, i) => (
          <div class="flex items-center flex-1">
            <div class="flex flex-col items-center">
              <div class="w-10 h-10 rounded-full bg-gold flex items-center justify-center shadow-md">
                <span class="text-white font-bold text-xs">{g}</span>
              </div>
            </div>
            {i < 3 && <div class="flex-1 h-px bg-gold/30 mx-2"></div>}
          </div>
        ))}
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {directivos.map((gen, i) => (
          <div class="reveal" style={`transition-delay:${i * 0.1}s`}>
            <!-- Cabecera de generación -->
            <div class={`p-4 mb-4 ${i === 0 ? 'bg-earth/10 border border-earth/20' : i === 1 ? 'bg-coffee/10 border border-coffee/20' : i === 2 ? 'bg-gold/10 border border-gold/20' : 'bg-coffee/10 border border-coffee/20'}`}>
              <span data-i18n={`jd.gen${i}.gen`} class={`text-xs font-bold tracking-widest uppercase block ${i === 0 ? 'text-earth' : i === 1 ? 'text-coffee' : i === 2 ? 'text-gold' : 'text-coffee'}`}>{gen.gen}</span>
              <span data-i18n={`jd.gen${i}.sub`} class="text-coffee/50 text-[10px] tracking-wider uppercase">{gen.sub}</span>
            </div>
            <!-- Miembros -->
            <div class="space-y-3">
              {gen.miembros.map(m => (
                <div class="bg-white border border-cream-dark p-4 hover:border-gold/40 transition-colors duration-200">
                  <div class="w-7 h-7 rounded-full bg-coffee/10 flex items-center justify-center mb-2">
                    <span class="text-coffee font-bold text-xs">{m.nombre.charAt(0)}</span>
                  </div>
                  <p class="font-display font-bold text-coffee-dark text-sm leading-tight mb-1">{m.nombre}</p>
                  <p class="text-earth text-xs leading-relaxed">{m.cargo}</p>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>



</Layout>
