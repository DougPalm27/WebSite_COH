    <script is:inline>
    (function () {
      var wrap = document.querySelector('.orbit-wrap');
      if (!wrap) return;
      var items = Array.from(wrap.querySelectorAll('.orbit-item'));
      var radius  = 290;   /* px desde el centro hasta los items */
      var period  = 28000; /* ms para una vuelta completa */
      var startAngles = items.map(function(el) {
        return parseFloat(el.dataset.startAngle) || 0;
      });
      var stacked = window.matchMedia('(max-width: 767px)');           /* versión apilada: sin órbita */
      var still   = window.matchMedia('(prefers-reduced-motion: reduce)');
      var elapsed = 0, last = null, raf = null, visible = false;

      var spokes = Array.from(wrap.querySelectorAll('.orbit-links__spoke'));
      var RIM = 222; /* borde de la tostadora, en unidades del viewBox (700) */

      function place(delta) {
        items.forEach(function(item, i) {
          var rad = (startAngles[i] + delta) * Math.PI / 180;
          var cos = Math.cos(rad), sin = Math.sin(rad);
          /* translate centra el item en su punto orbital */
          item.style.transform = 'translate(' + Math.round(cos * radius) + 'px, ' + Math.round(sin * radius) + 'px)';
          /* enlace desde el borde de la tostadora hasta el aliado */
          var sp = spokes[i];
          if (sp) {
            var line = sp.firstElementChild, dot = sp.lastElementChild;
            var x1 = 350 + cos * RIM, y1 = 350 + sin * RIM;
            line.setAttribute('x1', x1); line.setAttribute('y1', y1);
            line.setAttribute('x2', 350 + cos * radius); line.setAttribute('y2', 350 + sin * radius);
            dot.setAttribute('cx', x1); dot.setAttribute('cy', y1);
          }
        });
      }

      function tick(ts) {
        if (last !== null) elapsed += ts - last;
        last = ts;
        place((elapsed % period) / period * 360);
        raf = requestAnimationFrame(tick);
      }

      function update() {
        var run = visible && !stacked.matches && !still.matches;
        if (run && raf === null) { last = null; raf = requestAnimationFrame(tick); }
        if (!run && raf !== null) { cancelAnimationFrame(raf); raf = null; }
      }

      place(0); /* posición inicial (y definitiva si no hay animación) */
      new IntersectionObserver(function (entries) {
        visible = entries[0].isIntersecting;
        update();
      }).observe(wrap);
      stacked.addEventListener('change', update);
      still.addEventListener('change', update);
    })();
    </script>
