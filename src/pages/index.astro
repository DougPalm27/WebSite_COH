---

<style>
  @keyframes vec-float {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50%       { transform: translateY(-20px) rotate(4deg); }
  }
  @keyframes vec-float-rev {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50%       { transform: translateY(20px) rotate(-4deg); }
  }
  @keyframes vec-spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }
  @keyframes vec-spin-rev {
    from { transform: rotate(0deg); }
    to   { transform: rotate(-360deg); }
  }
  @keyframes vec-drift {
    0%, 100% { transform: translate(0, 0) rotate(0deg) scale(1); }
    33%       { transform: translate(14px, -10px) rotate(6deg) scale(1.04); }
    66%       { transform: translate(-10px, 8px) rotate(-4deg) scale(0.97); }
  }
  @keyframes vec-pulse-scale {
    0%, 100% { transform: scale(1);    opacity: 0.06; }
    50%       { transform: scale(1.08); opacity: 0.10; }
  }
  .vec-float     { animation: vec-float     12s ease-in-out infinite; }
  .vec-float-rev { animation: vec-float-rev 14s ease-in-out infinite; }
  .vec-spin      { animation: vec-spin      60s linear infinite; }
  .vec-spin-rev  { animation: vec-spin-rev  45s linear infinite; }
  .vec-drift     { animation: vec-drift     18s ease-in-out infinite; }
  .vec-pulse     { animation: vec-pulse-scale 8s ease-in-out infinite; }
</style>

<Layout title="Inicio" description="COHONDUCAFE — Empresa cafetalera hondureña desde 1954. Exportación, tostado, sostenibilidad y desarrollo comunitario.">

  <!-- ─── HERO ──────────────────────────────────────────────────── -->
  <section class="relative min-h-screen flex flex-col bg-[#1C0E08]">

    <!-- Fondo: slideshow con las 6 imágenes hero -->
    <div class="absolute inset-0 overflow-hidden" id="hero-slide-wrap">

      <!-- Diapositivas -->
      {[
        '/img/hero/hero1.jpg',
        '/img/hero/hero3.jpg',
        '/img/hero/hero4.jpg',
        '/img/hero/hero5.jpg',
        '/img/hero/hero6.jpeg',
        '/img/hero/hero7.png',
      ].map((src, i) => (
        <img
          src={src}
          alt=""
          aria-hidden="true"
          class="hero-slide absolute inset-0 w-full h-full object-cover transition-opacity duration-[1800ms] ease-in-out"
          style={`opacity:${i === 0 ? '1' : '0'};`}
        />
      ))}

      <!-- Overlays permanentes encima de las fotos -->
      <div class="absolute inset-0 pointer-events-none"
           style="background:linear-gradient(to right,rgba(28,14,8,0.93) 0%,rgba(28,14,8,0.72) 48%,rgba(28,14,8,0.28) 100%)">
      </div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#1C0E08]/70 via-transparent to-transparent pointer-events-none"></div>
      <div class="absolute inset-0 bg-grain opacity-30 pointer-events-none"></div>

      <!-- Indicadores de slide -->
      <div class="absolute bottom-8 right-8 z-20 flex gap-2" id="hero-dots">
        {[0,1,2,3,4,5].map(i => (
          <button
            class="hero-dot w-1.5 h-1.5 rounded-full bg-white/30 hover:bg-gold transition-colors duration-200"
            data-index={i}
            aria-label={`Imagen ${i + 1}`}
          ></button>
        ))}
      </div>
    </div>


    <!-- Watermark: año en fondo tenue -->
    <span class="hero-v3__ghost absolute font-display font-bold select-none pointer-events-none leading-none"
          aria-hidden="true"
          style="font-size:24vw;right:1vw;top:50%;transform:translateY(-52%);color:rgba(196,154,60,0.055)">
      1954
    </span>

    <!-- Contenido principal dinámico por slide -->
    <div class="relative z-10 flex-1 flex items-center">
      <div class="w-full px-6 lg:px-16 py-20 pt-32 max-w-4xl">

        <!-- Bloque de texto — se actualiza con cada slide -->
        <div id="hero-text" style="transition: opacity 0.35s ease, transform 0.35s ease;">

          <!-- Chip -->
          <div class="hero-v3__chip inline-flex items-center gap-2.5 bg-white/5 border border-white/10 rounded-full px-4 py-2 mb-10">
            <span class="w-1.5 h-1.5 rounded-full bg-gold shrink-0" style="animation:pulse 2s ease-in-out infinite"></span>
            <span id="hero-chip" data-i18n="idx.hero.slide0.chip" class="text-cream/65 text-[10px] font-semibold tracking-[0.38em] uppercase">Honduras · Café de Especialidad</span>
          </div>

          <!-- Título principal -->
          <div class="hero-titles-float">
            <div class="overflow-hidden mb-3">
              <h1 id="hero-title" class="hero-v3__h1a font-display font-bold text-white leading-[0.9] tracking-tight"
                  style="font-size:clamp(2rem,5.8vw,5.2rem)">
                COHONDUCAFE
              </h1>
            </div>
            <div class="overflow-hidden mb-9">
              <p id="hero-sub" data-i18n="idx.hero.slide0.sub" class="hero-v3__h1b font-display font-bold text-gold italic leading-[1.1] tracking-tight"
                  style="font-size:clamp(1.4rem,3vw,2.6rem)">
                Cuatro Generaciones.
              </p>
            </div>
          </div>

          <!-- Divisor dorado -->
          <div class="max-w-[200px] overflow-hidden mb-8">
            <div class="hero-v3__rule h-px bg-gradient-to-r from-gold/70 to-transparent"></div>
          </div>

          <!-- Descripción -->
          <p id="hero-desc" data-i18n="idx.hero.slide0.desc" class="hero-v3__para text-cream/55 text-base leading-relaxed max-w-[400px] mb-10">
            Una tradición familiar desde 1954, arraigada en Honduras y construida sobre
            confianza, colaboración y calidad exportada al mundo.
          </p>

          <!-- CTA -->
          <div class="hero-v3__ctas flex flex-wrap gap-3 mb-12">
            <a id="hero-cta" href="/nosotros"
               class="inline-flex items-center gap-2 bg-gold text-coffee-dark font-bold text-sm tracking-widest uppercase px-7 py-3.5 rounded-full hover:bg-gold-light transition-colors duration-200 group">
              <span id="hero-cta-label" data-i18n="idx.hero.slide0.cta">Nuestra Historia</span>
              <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>

          <!-- Pills de datos fijos -->
          <div class="hero-v3__stats flex flex-wrap gap-2.5">
            <div class="inline-flex items-center gap-3 bg-white/5 border border-white/10 rounded-full px-5 py-2.5 backdrop-blur-sm">
              <span class="font-display text-lg font-bold text-gold leading-none">1954</span>
              <span class="w-px h-4 bg-white/15"></span>
              <span data-i18n="idx.hero.s1" class="text-[9px] text-cream/40 font-bold tracking-[0.25em] uppercase">Establecido</span>
            </div>
            <div class="inline-flex items-center gap-3 bg-white/5 border border-white/10 rounded-full px-5 py-2.5 backdrop-blur-sm">
              <span class="font-display text-lg font-bold text-gold leading-none">+70</span>
              <span class="w-px h-4 bg-white/15"></span>
              <span data-i18n="idx.hero.s2" class="text-[9px] text-cream/40 font-bold tracking-[0.25em] uppercase">Años de liderazgo</span>
            </div>
            <div class="inline-flex items-center gap-3 bg-white/5 border border-white/10 rounded-full px-5 py-2.5 backdrop-blur-sm">
              <span class="font-display text-lg font-bold text-gold leading-none">100%</span>
              <span class="w-px h-4 bg-white/15"></span>
              <span data-i18n="idx.hero.s3" class="text-[9px] text-cream/40 font-bold tracking-[0.25em] uppercase">Café hondureño</span>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- Script: sincroniza texto con slides -->
    <script is:inline>
    (function () {
      var slideHrefs = ['/nosotros', '/nosotros', '/marcas', '/junta-directiva', '/contacto', '/nosotros'];

      function tt(key) {
        var lang = window.__COHON_LANG || 'es';
        var dict = (window.COHON_T || {})[lang] || {};
        if (dict[key] !== undefined) return dict[key];
        return ((window.COHON_T || {})['es'] || {})[key] || '';
      }

      function getSlide(i) {
        var k = 'idx.hero.slide' + i;
        return {
          chip:  tt(k + '.chip'),
          title: tt(k + '.title'),
          sub:   tt(k + '.sub'),
          desc:  tt(k + '.desc'),
          cta:   { label: tt(k + '.cta'), href: slideHrefs[i] }
        };
      }

      var textWrap  = document.getElementById('hero-text');
      var chipEl    = document.getElementById('hero-chip');
      var titleEl   = document.getElementById('hero-title');
      var subEl     = document.getElementById('hero-sub');
      var descEl    = document.getElementById('hero-desc');
      var ctaEl     = document.getElementById('hero-cta');
      var ctaLabel  = document.getElementById('hero-cta-label');

      function updateText(i) {
        var d = getSlide(i);
        /* Fade out + slide down */
        textWrap.style.opacity   = '0';
        textWrap.style.transform = 'translateY(14px)';

        setTimeout(function () {
          chipEl.textContent    = d.chip;
          titleEl.textContent   = d.title;
          subEl.textContent     = d.sub;
          descEl.textContent    = d.desc;
          ctaEl.href            = d.cta.href;
          ctaLabel.textContent  = d.cta.label;

          /* Fade in + slide up */
          textWrap.style.opacity   = '1';
          textWrap.style.transform = 'translateY(0)';
        }, 350);
      }

      /* Escucha al slideshow existente para sincronizarse */
      var imgSlides = document.querySelectorAll('.hero-slide');
      var dots      = document.querySelectorAll('.hero-dot');
      var total     = imgSlides.length;
      var current   = 0;

      function goTo(n) {
        imgSlides[current].style.opacity = '0';
        dots[current].classList.remove('bg-gold');
        dots[current].classList.add('bg-white/30');
        current = (n + total) % total;
        imgSlides[current].style.opacity = '1';
        dots[current].classList.remove('bg-white/30');
        dots[current].classList.add('bg-gold');
        updateText(current);
      }

      /* Activar primer dot */
      dots[0].classList.remove('bg-white/30');
      dots[0].classList.add('bg-gold');

      /* Auto-avance cada 6 s */
      var timer = setInterval(function () { goTo(current + 1); }, 6000);

      /* Click en dots */
      dots.forEach(function (dot, i) {
        dot.addEventListener('click', function () {
          clearInterval(timer);
          goTo(i);
          timer = setInterval(function () { goTo(current + 1); }, 6000);
        });
      });

      /* Re-render del slide actual al cambiar de idioma (sin animación) */
      window.addEventListener('cohonlangchange', function () {
        var d = getSlide(current);
        chipEl.textContent   = d.chip;
        titleEl.textContent  = d.title;
        subEl.textContent    = d.sub;
        descEl.textContent   = d.desc;
        ctaEl.href           = d.cta.href;
        ctaLabel.textContent = d.cta.label;
      });
    })();
    </script>

    <!-- Ticker animado -->
    <div class="relative z-10 border-t border-white/6 overflow-hidden py-3.5">
      <div class="hero-v3__ticker flex whitespace-nowrap text-[9.5px] font-bold tracking-[0.42em] uppercase text-cream/25 select-none">
        <span class="pr-12">DE LA FINCA A TU TAZA &nbsp;·&nbsp; DE LA FINCA A TU TAZA &nbsp;·&nbsp; DE LA FINCA A TU TAZA &nbsp;·&nbsp; DE LA FINCA A TU TAZA &nbsp;·&nbsp;</span>
        <span class="pr-12">DE LA FINCA A TU TAZA &nbsp;·&nbsp; DE LA FINCA A TU TAZA &nbsp;·&nbsp; DE LA FINCA A TU TAZA &nbsp;·&nbsp; DE LA FINCA A TU TAZA &nbsp;·&nbsp;</span>
      </div>
    </div>

    <!-- Scroll cue -->
    <div class="relative z-10 flex justify-center pb-5">
      <a href="#stats"
         class="scroll-cue text-cream/20 hover:text-gold transition-colors duration-200"
         aria-label="Desplázate hacia abajo">
        <span class="text-[9px] font-bold tracking-[0.35em] uppercase">Scroll</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
        </svg>
      </a>
    </div>

  </section>

  <!-- ─── CIFRAS ────────────────────────────────────────────────── -->
  <section id="stats" class="relative bg-cream py-20 overflow-hidden">
    <div class="gold-rule absolute inset-x-0 top-0"></div>
    <!-- Decoración: oval girando fondo derecha -->
    <div class="absolute -right-32 -top-32 w-96 h-96 pointer-events-none select-none opacity-[0.07] text-coffee vec-spin" aria-hidden="true">
      <img src="/svg/oval.svg" alt="" class="w-full h-full" style="filter: sepia(1) saturate(0.4);" />
    </div>
    <!-- Decoración: oval-alt girando sentido contrario izquierda -->
    <div class="absolute -left-20 -bottom-20 w-72 h-72 pointer-events-none select-none opacity-[0.06] vec-spin-rev" aria-hidden="true">
      <img src="/svg/oval-alt.svg" alt="" class="w-full h-full" style="filter: sepia(1) saturate(0.3);" />
    </div>
    <!-- Decoración: grano de café flotando -->
    <div class="absolute right-[12%] bottom-4 w-16 h-16 pointer-events-none select-none opacity-[0.08] vec-float" aria-hidden="true">
      <img src="/svg/benefit01.svg" alt="" class="w-full h-full" style="filter: sepia(1) saturate(0.5);" />
    </div>
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="grid grid-cols-2 md:grid-cols-4">
        {stats.map((item, i) => (
          <div
            class={`stat-group text-center py-10 px-4 md:px-8 reveal ${i > 0 ? 'border-l border-gold/15' : ''}`}
            style={`transition-delay:${i * 0.09}s`}
          >
            <div class="stat-icon">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d={item.iconPath}/>
              </svg>
            </div>
            <div class="stat-num mb-2.5">{item.num}</div>
            <div data-i18n={`idx.stats.${i}.lbl`} class="text-[10px] text-earth font-bold tracking-[0.3em] uppercase mb-1.5">{item.label}</div>
            <div data-i18n={`idx.stats.${i}.dsc`} class="text-xs text-coffee/55 font-medium">{item.desc}</div>
          </div>
        ))}
      </div>
    </div>
    <div class="gold-rule absolute inset-x-0 bottom-0"></div>
  </section>

  <script is:inline>
  (function () {
    var section = document.getElementById('stats');
    if (!section) return;
    var fired = false;
    var CHARS = '0123456789';

    /* Prep: stroke-dashoffset en cada path de ícono → invisible */
    section.querySelectorAll('.stat-icon svg path').forEach(function (path) {
      try {
        var len = path.getTotalLength();
        path.style.strokeDasharray  = len;
        path.style.strokeDashoffset = len;
        path.style.transition = 'stroke-dashoffset 0.85s cubic-bezier(0.16, 1, 0.3, 1)';
      } catch (e) {}
    });

    /* Scramble: cada dígito cicla caracteres aleatorios antes de resolverse */
    function scramble(el, delay) {
      var target = el.textContent.trim();
      setTimeout(function () {
        var frame = 0, total = 22;
        var id = setInterval(function () {
          el.textContent = target.split('').map(function (ch, ci) {
            if (!/\d/.test(ch)) return ch;            /* +, % se quedan fijos */
            if (frame >= total - ci * 2.2) return ch; /* cada dígito resuelve en cascada */
            return CHARS[Math.floor(Math.random() * CHARS.length)];
          }).join('');
          if (++frame > total) { clearInterval(id); el.textContent = target; }
        }, 42); /* ~42ms por frame = ~924ms total */
      }, delay);
    }

    new IntersectionObserver(function (entries) {
      if (fired || !entries[0].isIntersecting) return;
      fired = true;

      /* 1 — Sweep de luz dorada de izquierda a derecha */
      section.classList.add('stats-sweep');

      section.querySelectorAll('.stat-group').forEach(function (group, i) {
        var d = i * 190;

        /* 2 — Draw: el ícono se dibuja solo */
        group.querySelectorAll('.stat-icon svg path').forEach(function (path) {
          setTimeout(function () { path.style.strokeDashoffset = '0'; }, d + 60);
        });

        /* 3 — Scramble: el número decodifica */
        var numEl = group.querySelector('.stat-num');
        if (numEl) scramble(numEl, d + 60);
      });

    }, { threshold: 0.28 }).observe(section);
  })();
  </script>

  <!-- ─── ABOUT INTRO ───────────────────────────────────────────── -->
  <section id="about-intro" class="py-24 bg-cream-light overflow-hidden relative">
    <!-- Decoración: planta de café grande derecha superior -->
    <div class="absolute -right-16 -top-10 w-80 h-96 pointer-events-none select-none opacity-[0.05] vec-drift" aria-hidden="true">
      <img src="/svg/coffee.svg" alt="" class="w-full h-full" style="filter: sepia(1) saturate(0.6);" />
    </div>
    <!-- Decoración: oval pulsante centro izquierda -->
    <div class="absolute -left-24 top-1/2 -translate-y-1/2 w-64 h-64 pointer-events-none select-none vec-pulse" aria-hidden="true">
      <img src="/svg/oval-alt.svg" alt="" class="w-full h-full" style="filter: sepia(1) saturate(0.3);" />
    </div>
    <div class="max-w-7xl mx-auto px-6 lg:px-12 grid lg:grid-cols-2 gap-16 items-center">

      <!-- Imágenes apiladas -->
      <div class="relative h-[500px]">
        <img
          src="/img/raices_profundas/raiz1.jpg"
          alt="Cultivo de café Cohonducafe"
          class="about-clip-left absolute top-0 left-0 w-3/4 h-80 object-cover shadow-2xl"
        />
        <img
          src="/img/raices_profundas/raiz2.png"
          alt="Comunidad cafetalera"
          class="about-clip-right absolute bottom-0 right-0 w-3/4 h-72 object-cover shadow-2xl border-8 border-cream-light"
        />
        <div class="about-badge absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-28 h-28 rounded-full bg-gold flex flex-col items-center justify-center text-white shadow-xl">
          <span class="about-badge-num font-display text-2xl font-bold leading-none">70+</span>
          <span class="text-xs font-semibold tracking-wider uppercase mt-1">años</span>
        </div>
      </div>

      <!-- Texto -->
      <div>
        <p data-i18n="idx.about.label" class="section-label mb-4 reveal">Quiénes somos</p>
        <h2 class="font-display text-4xl md:text-5xl font-bold text-coffee-dark leading-tight mb-6 reveal">
          <span data-i18n="idx.about.h2a">Una empresa</span><br/><span data-i18n="idx.about.h2b" class="italic text-coffee">con raíces profundas</span>
        </h2>
        <p data-i18n="idx.about.p1" class="text-coffee/80 leading-relaxed mb-5 reveal">
          COHONDUCAFE nació en 1954 como una cooperativa cafetalera en las montañas de Honduras. Hoy somos un grupo empresarial integrado que abarca desde la producción en finca hasta la exportación internacional.
        </p>
        <p data-i18n="idx.about.p2" class="text-coffee/80 leading-relaxed mb-8 reveal">
          Nuestro modelo une calidad de grano, responsabilidad ambiental y desarrollo comunitario — porque creemos que el mejor café viene de comunidades prósperas y bosques sanos.
        </p>
        <a href="/nosotros" class="btn-primary reveal"><span data-i18n="idx.about.cta">Nuestra historia</span></a>

        <!-- Certificaciones -->
        <div class="mt-10 pt-8 border-t border-forest/10 reveal" style="transition-delay:0.35s">
          <p class="text-[9px] text-gold font-bold tracking-[0.3em] uppercase mb-3">Certificaciones internacionales</p>
          <div class="flex flex-wrap gap-2">
            {['USDA Organic', 'EU Organic', '4C', 'Rainforest Alliance', 'Fairtrade'].map(cert => (
