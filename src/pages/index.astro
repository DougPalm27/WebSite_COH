    <script is:inline>
    (function () {
      var wrap = document.querySelector('.orbit-wrap');
      if (!wrap) return;
      var items = Array.from(wrap.querySelectorAll('.orbit-item'));
      var radius  = 290;   /* px desde el centro hasta los items */
      var period  = 28000; /* ms para una vuelta completa */
      var startAngles = items.map(function(el) {
        return parseFloat(el.dataset.startAngle) || 0;
      });
      var startTime = null;

      function tick(ts) {
        if (!startTime) startTime = ts;
        var delta = ((ts - startTime) % period) / period * 360;

        items.forEach(function(item, i) {
          var deg = startAngles[i] + delta;
          var rad = deg * Math.PI / 180;
          var x   = Math.round(Math.cos(rad) * radius);
          var y   = Math.round(Math.sin(rad) * radius);
          /* translate centra el item en su punto orbital */
          item.style.transform = 'translate(' + x + 'px, ' + y + 'px)';
        });

        requestAnimationFrame(tick);
      }

      requestAnimationFrame(tick);
    })();
    </script>
