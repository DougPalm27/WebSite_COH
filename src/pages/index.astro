---
import Layout from '../layouts/Layout.astro';

const marcas = [
  {
    slug: 'hosco',
    i18nPrefix: 'mar.hosco',
    nombre: 'HOSCO',
    tipo: 'Comercialización & Exportación',
    desc: 'Exportación y comercialización de café hondureño de especialidad hacia mercados internacionales.',
    img: '/img/marcas/Hosco/hosco.webp',
  },
  {
    slug: 'minahonda',
    i18nPrefix: 'mar.mh',
    nombre: 'Mina Honda',
    tipo: 'Producción en Finca',
    desc: 'Finca modelo de producción sostenible en las alturas de Honduras.',
    img: '/img/marcas/MinaHonda/minahonda.webp',
  },
  {
    slug: 'fundacion',
    i18nPrefix: 'mar.fund',
    nombre: 'Fundación COHONDUCAFE',
    tipo: 'Responsabilidad Social',
    desc: 'Desarrollo comunitario, educación y proyectos sociales para las familias cafetaleras.',
    img: '/img/marcas/Fundacion/fundacion1.webp',
  },
];

const stats = [
  {
    num: '+70',
    label: 'Años de experiencia',
    desc: 'Cuatro generaciones',
    iconPath: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    num: '+40,000',
    label: 'Hogares productores',
    desc: 'Trabajo directo',
    iconPath: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6',
  },
  {
    num: '+200,000',
    label: 'Personas beneficiadas',
    desc: 'En zonas cafetaleras',
    iconPath: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
  },
  {
    num: '30%',
    label: 'De la producción nacional',
    desc: 'Exportada en 2022',
    iconPath: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4',
  },
];
---

<style>
  @keyframes vec-float {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50%       { transform: translateY(-20px) rotate(4deg); }
  }
  @keyframes vec-float-rev {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50%       { transform: translateY(20px) rotate(-4deg); }
  }
  @keyframes vec-spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }
  @keyframes vec-spin-rev {
    from { transform: rotate(0deg); }
    to   { transform: rotate(-360deg); }
  }
  @keyframes vec-drift {
    0%, 100% { transform: translate(0, 0) rotate(0deg) scale(1); }
    33%       { transform: translate(14px, -10px) rotate(6deg) scale(1.04); }
    66%       { transform: translate(-10px, 8px) rotate(-4deg) scale(0.97); }
  }
  @keyframes vec-pulse-scale {
    0%, 100% { transform: scale(1);    opacity: 0.06; }
    50%       { transform: scale(1.08); opacity: 0.10; }
  }
  .vec-float     { animation: vec-float     12s ease-in-out infinite; }
  .vec-float-rev { animation: vec-float-rev 14s ease-in-out infinite; }
  .vec-spin      { animation: vec-spin      60s linear infinite; }
  .vec-spin-rev  { animation: vec-spin-rev  45s linear infinite; }
  .vec-drift     { animation: vec-drift     18s ease-in-out infinite; }
  .vec-pulse     { animation: vec-pulse-scale 8s ease-in-out infinite; }
</style>

<Layout title="Inicio" description="COHONDUCAFE — Empresa cafetalera hondureña desde 1954. Exportación, tostado, sostenibilidad y desarrollo comunitario.">

  <!-- ─── HERO CINEMATOGRÁFICO ─────────────────────────────────────
       Fondo: tomas del video institucional sin subtítulos (scripts/hero-video.sh).
       Se muestra primero la portada y el video entra con un fundido al estar listo.
       Pantallas verticales usan la versión vertical; sin video si el usuario pidió
       reducir movimiento o tiene activado el ahorro de datos. -->
  <section class="relative min-h-[100svh] flex flex-col bg-[#1C0E08] overflow-hidden">

    <div class="absolute inset-0" aria-hidden="true">
      <picture>
        <source media="(max-aspect-ratio: 1/1)" srcset="/img/hero/hero-movil-portada.jpg" />
        <img src="/img/hero/hero-escritorio-portada.jpg" alt="" fetchpriority="high"
             class="absolute inset-0 w-full h-full object-cover" />
      </picture>
      <video id="hero-video" muted loop playsinline preload="none"
             class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-1000"></video>

      <!-- Oscurecido para que el texto se lea: lateral en pantallas anchas, inferior en verticales -->
      <div class="absolute inset-0 hidden md:block"
           style="background:linear-gradient(to right,rgba(28,14,8,0.9) 0%,rgba(28,14,8,0.6) 42%,rgba(28,14,8,0.15) 100%)"></div>
      <div class="absolute inset-0 md:hidden"
           style="background:linear-gradient(to top,rgba(28,14,8,0.95) 0%,rgba(28,14,8,0.6) 55%,rgba(28,14,8,0.35) 100%)"></div>
      <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-[#1C0E08]/80 to-transparent"></div>
    </div>

    <!-- Mensaje -->
    <div class="relative z-10 flex-1 flex items-end md:items-center">
      <div class="w-full max-w-7xl mx-auto px-6 lg:px-12 pt-32 pb-10 md:py-32">

        <div class="hero-v3__chip inline-flex items-center gap-2.5 bg-white/5 border border-white/15 rounded-full px-4 py-2 mb-8 backdrop-blur-sm">
          <span class="w-1.5 h-1.5 rounded-full bg-gold shrink-0"></span>
          <span data-i18n="idx.hero.label" class="text-cream/90 text-xs font-semibold tracking-[0.18em] sm:tracking-[0.3em] uppercase">COHONDUCAFE · Honduras · Desde 1954</span>
        </div>

        <!-- Cada línea entra desde abajo; pb deja espacio a los trazos descendentes dentro del recorte -->
        <h1 class="font-display font-bold text-white leading-[1.02] tracking-tight max-w-4xl mb-8"
            style="font-size:clamp(2.6rem,6.2vw,6rem)">
          <span class="block overflow-hidden pb-[0.1em]">
            <span data-i18n="idx.hero.h1a" class="hero-v3__h1a block">Del corazón de Honduras</span>
          </span>
          <span class="block overflow-hidden pb-[0.2em] -mt-[0.1em]">
            <span data-i18n="idx.hero.h1b" class="hero-v3__h1b block text-gold italic">al mundo.</span>
          </span>
        </h1>

        <div class="max-w-[200px] overflow-hidden mb-8">
          <div class="hero-v3__rule h-px bg-gradient-to-r from-gold/80 to-transparent"></div>
        </div>

        <p data-i18n="idx.hero.desc" class="hero-v3__para text-cream/90 text-base md:text-lg leading-relaxed max-w-xl mb-10">
          Cuatro generaciones cultivando, procesando y exportando café hondureño de especialidad desde 1954.
        </p>

        <div class="hero-v3__ctas flex flex-wrap gap-3">
          <a href="/contacto?tema=importacion"
             class="inline-flex items-center gap-2 bg-gold text-coffee-dark font-bold text-sm tracking-widest uppercase px-7 py-4 rounded-full hover:bg-gold-light transition-colors duration-200 group">
            <span data-i18n="idx.cta.btn1">Hablemos de negocios</span>
            <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
          <a href="/nosotros"
             class="inline-flex items-center gap-2 border border-white/40 text-white font-bold text-sm tracking-widest uppercase px-7 py-4 rounded-full hover:bg-white/10 hover:border-white/70 transition-colors duration-200">
            <span data-i18n="idx.about.cta">Nuestra historia</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Barra inferior: pausa del video y aviso de scroll -->
    <div class="relative z-10 max-w-7xl w-full mx-auto px-6 lg:px-12 pb-6 flex items-center justify-between">
      <button id="hero-video-btn" type="button" hidden
              class="w-10 h-10 rounded-full border border-white/40 text-white/90 flex items-center justify-center hover:border-gold hover:text-gold transition-colors duration-200"
              aria-label="Pausar video" data-i18n-aria="a11y.video.pause">
        <svg data-icon="pause" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
        <svg data-icon="play" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13a1 1 0 001.5.86l10.5-6.5a1 1 0 000-1.72L9.5 4.64A1 1 0 008 5.5z"/></svg>
      </button>
      <a href="#stats"
         class="scroll-cue text-cream/80 hover:text-gold transition-colors duration-200 ml-auto"
         aria-label="Desplázate hacia abajo" data-i18n-aria="a11y.scroll">
        <span data-i18n="idx.scroll" class="text-xs font-bold tracking-[0.35em] uppercase">Scroll</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
        </svg>
      </a>
    </div>

    <script is:inline>
    (function () {
      var v   = document.getElementById('hero-video');
      var btn = document.getElementById('hero-video-btn');
      if (!v) return;

      var still    = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var saveData = navigator.connection && navigator.connection.saveData;
      if (still || saveData) return;               /* se queda la portada fija */

      var vertical = window.matchMedia('(max-aspect-ratio: 1/1)').matches;
      var src = vertical ? '/img/hero/hero-movil.mp4' : '/img/hero/hero-escritorio.mp4';
      var userPaused = false, onScreen = true;

      function tt(key, fallback) {
        var d = (window.COHON_T || {})[window.__COHON_LANG || 'es'] || {};
        return d[key] || fallback;
      }
      function syncButton() {
        var paused = v.paused;
        btn.querySelector('[data-icon="pause"]').classList.toggle('hidden', paused);
        btn.querySelector('[data-icon="play"]').classList.toggle('hidden', !paused);
        var key = paused ? 'a11y.video.play' : 'a11y.video.pause';
        btn.setAttribute('data-i18n-aria', key);
        btn.setAttribute('aria-label', tt(key, paused ? 'Reproducir video' : 'Pausar video'));
      }
      function play() { var p = v.play(); if (p) p.catch(function () {}); }

      v.addEventListener('playing', function () { v.classList.remove('opacity-0'); syncButton(); });
      v.addEventListener('pause', syncButton);

      btn.addEventListener('click', function () {
        userPaused = !v.paused;
        if (userPaused) v.pause(); else play();
      });

      /* Pausar cuando el hero no está en pantalla (ahorra batería y CPU) */
      new IntersectionObserver(function (e) {
        onScreen = e[0].isIntersecting;
        if (!v.src) return;
        if (onScreen && !userPaused) play(); else v.pause();
      }).observe(v);

      /* Cargar el video cuando el resto de la página ya terminó */
      function start() {
        v.src = src;
        btn.hidden = false;
        if (onScreen) play();
      }
      if (document.readyState === 'complete') start();
      else window.addEventListener('load', start);

      window.addEventListener('cohonlangchange', syncButton);
    })();
    </script>

  </section>

  <!-- ─── CIFRAS ────────────────────────────────────────────────── -->
  <section id="stats" class="relative bg-cream py-20 overflow-hidden">
    <div class="gold-rule absolute inset-x-0 top-0"></div>
    <!-- Decoración: oval girando fondo derecha -->
    <div class="absolute -right-32 -top-32 w-96 h-96 pointer-events-none select-none opacity-[0.07] text-coffee vec-spin" aria-hidden="true">
      <img loading="lazy" decoding="async" src="/svg/oval.svg" alt="" class="w-full h-full" style="filter: sepia(1) saturate(0.4);" />
    </div>
    <!-- Decoración: oval-alt girando sentido contrario izquierda -->
    <div class="absolute -left-20 -bottom-20 w-72 h-72 pointer-events-none select-none opacity-[0.06] vec-spin-rev" aria-hidden="true">
      <img loading="lazy" decoding="async" src="/svg/oval-alt.svg" alt="" class="w-full h-full" style="filter: sepia(1) saturate(0.3);" />
    </div>
    <!-- Decoración: grano de café flotando -->
    <div class="absolute right-[12%] bottom-4 w-16 h-16 pointer-events-none select-none opacity-[0.08] vec-float" aria-hidden="true">
      <img loading="lazy" decoding="async" src="/svg/benefit01.svg" alt="" class="w-full h-full" style="filter: sepia(1) saturate(0.5);" />
    </div>
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="grid grid-cols-2 md:grid-cols-4">
        {stats.map((item, i) => (
          <div
            class={`stat-group text-center py-10 px-2 md:px-4 reveal ${i > 0 ? 'border-l border-gold/15' : ''}`}
            style={`transition-delay:${i * 0.09}s`}
          >
            <div class="stat-icon">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d={item.iconPath}/>
              </svg>
            </div>
            <div class="stat-num mb-2.5">{item.num}</div>
            <div data-i18n={`idx.stats.${i}.lbl`} class="text-xs text-earth font-bold tracking-[0.3em] uppercase mb-1.5">{item.label}</div>
            <div data-i18n={`idx.stats.${i}.dsc`} class="text-xs text-coffee/85 font-medium">{item.desc}</div>
          </div>
        ))}
      </div>
    </div>
    <div class="gold-rule absolute inset-x-0 bottom-0"></div>
  </section>

  <script is:inline>
  (function () {
    var section = document.getElementById('stats');
    if (!section) return;
    var fired = false;
    var CHARS = '0123456789';

    /* Prep: stroke-dashoffset en cada path de ícono → invisible */
    section.querySelectorAll('.stat-icon svg path').forEach(function (path) {
      try {
        var len = path.getTotalLength();
        path.style.strokeDasharray  = len;
        path.style.strokeDashoffset = len;
        path.style.transition = 'stroke-dashoffset 0.85s cubic-bezier(0.16, 1, 0.3, 1)';
      } catch (e) {}
    });

    /* Scramble: cada dígito cicla caracteres aleatorios antes de resolverse */
    function scramble(el, delay) {
      var target = el.textContent.trim();
      setTimeout(function () {
        var frame = 0, total = 22;
        var id = setInterval(function () {
          el.textContent = target.split('').map(function (ch, ci) {
            if (!/\d/.test(ch)) return ch;            /* +, % se quedan fijos */
            if (frame >= total - ci * 2.2) return ch; /* cada dígito resuelve en cascada */
            return CHARS[Math.floor(Math.random() * CHARS.length)];
          }).join('');
          if (++frame > total) { clearInterval(id); el.textContent = target; }
        }, 42); /* ~42ms por frame = ~924ms total */
      }, delay);
    }

    new IntersectionObserver(function (entries) {
      if (fired || !entries[0].isIntersecting) return;
      fired = true;

      /* 1 — Sweep de luz dorada de izquierda a derecha */
      section.classList.add('stats-sweep');

      section.querySelectorAll('.stat-group').forEach(function (group, i) {
        var d = i * 190;

        /* 2 — Draw: el ícono se dibuja solo */
        group.querySelectorAll('.stat-icon svg path').forEach(function (path) {
          setTimeout(function () { path.style.strokeDashoffset = '0'; }, d + 60);
        });

        /* 3 — Scramble: el número decodifica */
        var numEl = group.querySelector('.stat-num');
        if (numEl) scramble(numEl, d + 60);
      });

    }, { threshold: 0.28 }).observe(section);
  })();
  </script>

  <!-- ─── ABOUT INTRO ───────────────────────────────────────────── -->
  <section id="about-intro" class="py-24 bg-cream-light overflow-hidden relative">
    <!-- Decoración: planta de café grande derecha superior -->
    <div class="absolute -right-16 -top-10 w-80 h-96 pointer-events-none select-none opacity-[0.05] vec-drift" aria-hidden="true">
      <img loading="lazy" decoding="async" src="/svg/coffee.svg" alt="" class="w-full h-full" style="filter: sepia(1) saturate(0.6);" />
    </div>
    <!-- Decoración: oval pulsante centro izquierda -->
    <div class="absolute -left-24 top-1/2 -translate-y-1/2 w-64 h-64 pointer-events-none select-none vec-pulse" aria-hidden="true">
      <img loading="lazy" decoding="async" src="/svg/oval-alt.svg" alt="" class="w-full h-full" style="filter: sepia(1) saturate(0.3);" />
    </div>
    <div class="max-w-7xl mx-auto px-6 lg:px-12 grid lg:grid-cols-2 gap-16 items-center">

      <!-- Imágenes apiladas -->
      <div class="relative h-[500px]">
        <img loading="lazy" decoding="async"
          src="/img/raices_profundas/raiz1.webp"
          alt="Cultivo de café COHONDUCAFE"
          class="about-clip-left absolute top-0 left-0 w-3/4 h-80 object-cover shadow-2xl"
        />
        <img loading="lazy" decoding="async"
          src="/img/raices_profundas/raiz2.webp"
          alt="Comunidad cafetalera"
          class="about-clip-right absolute bottom-0 right-0 w-3/4 h-72 object-cover shadow-2xl border-8 border-cream-light"
        />
        <div class="about-badge absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-28 h-28 rounded-full bg-gold flex flex-col items-center justify-center text-coffee-dark shadow-xl">
          <span class="about-badge-num font-display text-2xl font-bold leading-none">70+</span>
          <span data-i18n="idx.about.yrs" class="text-xs font-semibold tracking-wider uppercase mt-1">años</span>
        </div>
      </div>

      <!-- Texto -->
      <div>
        <p data-i18n="idx.about.label" class="section-label mb-4 reveal">Quiénes somos</p>
        <h2 class="font-display text-4xl md:text-5xl font-bold text-coffee-dark leading-tight mb-6 reveal">
          <span data-i18n="idx.about.h2a">Una empresa</span><br/><span data-i18n="idx.about.h2b" class="italic text-coffee">con raíces profundas</span>
        </h2>
        <p data-i18n="idx.about.p1" class="text-coffee/85 leading-relaxed mb-5 reveal">
          COHONDUCAFE nació en 1954 como una empresa familiar cafetalera en las montañas de Honduras. Hoy somos un grupo empresarial integrado que abarca desde la producción en finca hasta la exportación internacional.
        </p>
        <p data-i18n="idx.about.p2" class="text-coffee/85 leading-relaxed mb-8 reveal">
          Nuestro modelo une calidad de grano, responsabilidad ambiental y desarrollo comunitario — porque creemos que el mejor café viene de comunidades prósperas y bosques sanos.
        </p>
        <a href="/nosotros" class="btn-primary reveal"><span data-i18n="idx.about.cta">Nuestra historia</span></a>

        <!-- Certificaciones -->
        <div class="mt-10 pt-8 border-t border-forest/10 reveal" style="transition-delay:0.35s">
          <p data-i18n="idx.about.certs" class="text-xs text-gold font-bold tracking-[0.3em] uppercase mb-3">Certificaciones internacionales</p>
          <div class="flex flex-wrap gap-2">
            {['USDA Organic', 'EU Organic', '4C', 'Rainforest Alliance', 'Fairtrade'].map(cert => (
              <span class="text-xs font-bold tracking-widest uppercase border border-coffee/20 text-coffee/85 px-3 py-1.5 hover:border-gold hover:text-gold transition-all duration-200 cursor-default">
                {cert}
              </span>
            ))}
          </div>
        </div>
      </div>

    </div>
  </section>

  <script is:inline>
  (function () {
    var section = document.getElementById('about-intro');
    if (!section) return;
    var fired = false;
    var CHARS = '0123456789';

    function scramble(el, delay) {
      var target = el.textContent.trim();
      setTimeout(function () {
        var frame = 0, total = 22;
        var id = setInterval(function () {
          el.textContent = target.split('').map(function (ch, ci) {
            if (!/\d/.test(ch)) return ch;
            if (frame >= total - ci * 2.5) return ch;
            return CHARS[Math.floor(Math.random() * CHARS.length)];
          }).join('');
          if (++frame > total) { clearInterval(id); el.textContent = target; }
        }, 42);
      }, delay);
    }

    new IntersectionObserver(function (entries) {
      if (fired || !entries[0].isIntersecting) return;
      fired = true;

      /* Clip-path reveal en imágenes */
      var left  = section.querySelector('.about-clip-left');
      var right = section.querySelector('.about-clip-right');
      if (left)  left.classList.add('is-revealed');
      if (right) right.classList.add('is-revealed');

      /* Badge pop + scramble en "70+" */
      var badge  = section.querySelector('.about-badge');
      var numEl  = section.querySelector('.about-badge-num');
      if (badge) badge.classList.add('is-revealed');
      if (numEl) scramble(numEl, 380);

    }, { threshold: 0.22 }).observe(section);
  })();
  </script>

  <!-- ─── ALIANZAS ESTRATÉGICAS (reemplaza Socios y aliados) ────── -->
  <section class="alianzas-section tone-light relative overflow-hidden">
    <!-- Decoración: oval grande girando fondo -->
    <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] pointer-events-none select-none opacity-[0.04] vec-spin" aria-hidden="true">
      <img loading="lazy" decoding="async" src="/svg/oval.svg" alt="" class="w-full h-full brightness-200" />
    </div>
    <!-- Decoración: coffee flotando esquina inferior izquierda -->
    <div class="absolute -left-10 bottom-0 w-48 h-60 pointer-events-none select-none opacity-[0.06] vec-float-rev" aria-hidden="true">
      <img loading="lazy" decoding="async" src="/svg/coffee.svg" alt="" class="w-full h-full brightness-200" />
    </div>
    <div class="max-w-7xl mx-auto px-6 lg:px-12 relative z-10 py-24">
      <div class="flex flex-col xl:flex-row xl:items-center gap-16 xl:gap-20">

        <!-- IZQUIERDA: Plan Estratégico -->
        <div class="max-w-xl xl:max-w-none xl:w-[400px] shrink-0">
          <p data-i18n="idx.ali.label" class="section-label mb-4 reveal">Red de colaboración</p>
          <h2 data-i18n="idx.ali.h2" class="font-display text-4xl font-bold text-coffee-dark mb-10 reveal">Alianzas Estratégicas</h2>

