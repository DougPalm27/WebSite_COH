  <script is:inline>
  (function () {
    var section = document.getElementById('about-intro');
    if (!section) return;
    var fired = false;
    var CHARS = '0123456789';

    function scramble(el, delay) {
      var target = el.textContent.trim();
      setTimeout(function () {
        var frame = 0, total = 22;
        var id = setInterval(function () {
          el.textContent = target.split('').map(function (ch, ci) {
            if (!/\d/.test(ch)) return ch;
            if (frame >= total - ci * 2.5) return ch;
            return CHARS[Math.floor(Math.random() * CHARS.length)];
          }).join('');
          if (++frame > total) { clearInterval(id); el.textContent = target; }
        }, 42);
      }, delay);
    }

    new IntersectionObserver(function (entries) {
      if (fired || !entries[0].isIntersecting) return;
      fired = true;

      /* Clip-path reveal en imágenes */
      var left  = section.querySelector('.about-clip-left');
      var right = section.querySelector('.about-clip-right');
      if (left)  left.classList.add('is-revealed');
      if (right) right.classList.add('is-revealed');

      /* Badge pop + scramble en "70+" */
      var badge  = section.querySelector('.about-badge');
      var numEl  = section.querySelector('.about-badge-num');
      if (badge) badge.classList.add('is-revealed');
      if (numEl) scramble(numEl, 380);

    }, { threshold: 0.22 }).observe(section);
  })();
  </script>

