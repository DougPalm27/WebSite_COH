    ]
  },
  {
    gen: '4ta Generación', sub: 'Nueva generación', year: '2010s',
    color: '#3E2410',
    miembros: [
      {
        nombre: 'Basilio Fuschich', cargo: 'Comercialización de Café',
        detalle: '', img: '/img/junta%20directiva/BF%20JR.webp',
        bio: 'Parte de la nueva generación que está llevando el café hondureño a nuevos mercados. Especializado en comercialización, trabaja en fortalecer las relaciones con importadores y tostadores internacionales.',
        pills: ['Comercialización', 'Mercados internacionales', '4ta generación'],
      },
      {
        nombre: 'Christopher Fuschich', cargo: 'Control de Calidad',
        detalle: '', img: '/img/junta%20directiva/CF.webp',
        bio: 'Enfocado en mantener y elevar los estándares de calidad del café COHONDUCAFE. Su trabajo asegura que cada lote exportado cumpla con las exigencias de los mercados de especialidad más exigentes del mundo.',
        pills: ['Control de calidad', 'Café de especialidad', 'Catación'],
      },
      {
        nombre: 'Samuel Bendeck', cargo: 'Comercialización · Finanzas',
        detalle: '', img: '/img/junta%20directiva/SB.webp',
        bio: 'Combina su rol en comercialización con la gestión financiera del grupo, aportando una visión estratégica integral. Impulsa la modernización de los procesos comerciales y financieros de COHONDUCAFE.',
        pills: ['Finanzas', 'Comercialización', 'Estrategia'],
      },
    ]
  },
];

// Atributos comunes de cada tarjeta: los usa el modal de biografía (árbol y lista)
type Gen = typeof directivos[number];
type Miembro = Gen['miembros'][number] & { nombre2?: string; cargo2?: string; img2?: string };
function cardAttrs(m: Miembro, gen: Gen) {
  const nombre = m.nombre2 ? `${m.nombre} & ${m.nombre2}` : m.nombre;
  return {
    role: 'button', tabindex: '0',
    'aria-label': `Ver biografía: ${m.nombre2 ? `${m.nombre} y ${m.nombre2}` : m.nombre}`,
    'data-i18n-aria': 'a11y.bio', 'data-i18n-n': nombre,
    'data-nombre': nombre,
    'data-cargo': m.nombre2 ? `${m.cargo} · ${m.cargo2}` : m.cargo,
    'data-bio': m.bio || '',
    'data-pills': m.pills ? m.pills.join('||') : '',
    'data-color': gen.color,
    'data-img': m.nombre2 ? (m.img2 || '') : (m.img || ''),
  };
}

// ── Cálculo de posiciones para los conectores SVG ──────────────────────
const CARD_H  = 160;   // altura de cada tarjeta (px)
const CARD_G  = 16;    // gap entre tarjetas (px)
const UNIT    = CARD_H + CARD_G;
const IMG_W   = 104;   // ancho de la foto en las tarjetas del árbol (px)
const CONN_W  = 40;    // ancho del área de conector
const L_BAR   = 8;     // x de la barra vertical izquierda del conector
const R_BAR   = CONN_W - 8; // x de la barra vertical derecha

const counts  = directivos.map(g => g.miembros.length);
const maxH    = Math.max(...counts.map(n => n * CARD_H + (n - 1) * CARD_G));

function getCenters(n: number): number[] {
  const colH  = n * CARD_H + (n - 1) * CARD_G;
  const offset = (maxH - colH) / 2;
  return Array.from({ length: n }, (_, i) => offset + CARD_H / 2 + i * UNIT);
}

// Para cada par de generaciones contiguas, precalculo el SVG path
interface ConnectorData {
  d: string;
  h: number;
  w: number;
}

const connectors: ConnectorData[] = [];
for (let i = 0; i < directivos.length - 1; i++) {
  const lc = getCenters(counts[i]);
  const rc = getCenters(counts[i + 1]);
  const mid = maxH / 2;

  const paths: string[] = [];

  // Stubs izquierdos (desde tarjeta hasta barra vertical)
  lc.forEach(y => paths.push(`M0,${y} H${L_BAR}`));
  // Barra vertical izquierda
  if (lc.length > 1) paths.push(`M${L_BAR},${lc[0]} V${lc[lc.length - 1]}`);
  // Línea horizontal central
  paths.push(`M${L_BAR},${mid} H${R_BAR}`);
  // Barra vertical derecha
  if (rc.length > 1) paths.push(`M${R_BAR},${rc[0]} V${rc[rc.length - 1]}`);
  // Stubs derechos (desde barra vertical hasta tarjeta)
  rc.forEach(y => paths.push(`M${R_BAR},${y} H${CONN_W}`));

  connectors.push({ d: paths.join(' '), h: maxH, w: CONN_W });
}
---

<style>
  /* ── Vectores decorativos ─────────────────────────────────────── */
  @keyframes vec-float     { 0%,100%{transform:translateY(0px) rotate(0deg)} 50%{transform:translateY(-20px) rotate(4deg)} }
  @keyframes vec-float-rev { 0%,100%{transform:translateY(0px) rotate(0deg)} 50%{transform:translateY(20px) rotate(-4deg)} }
  @keyframes vec-spin      { from{transform:rotate(0deg)} to{transform:rotate(360deg)} }
  @keyframes vec-spin-rev  { from{transform:rotate(0deg)} to{transform:rotate(-360deg)} }
  @keyframes vec-drift     { 0%,100%{transform:translate(0,0) rotate(0deg) scale(1)} 33%{transform:translate(14px,-10px) rotate(6deg) scale(1.04)} 66%{transform:translate(-10px,8px) rotate(-4deg) scale(0.97)} }
  @keyframes vec-pulse-scale { 0%,100%{transform:scale(1);opacity:0.06} 50%{transform:scale(1.08);opacity:0.10} }
  .vec-float     { animation: vec-float      11s ease-in-out infinite; }
  .vec-float-rev { animation: vec-float-rev  17s ease-in-out infinite; }
  .vec-spin      { animation: vec-spin       70s linear infinite; }
  .vec-spin-rev  { animation: vec-spin-rev   50s linear infinite; }
  .vec-drift     { animation: vec-drift      24s ease-in-out infinite; }
  .vec-pulse     { animation: vec-pulse-scale 11s ease-in-out infinite; }

  /* ── Ken Burns en banner ──────────────────────────────────────── */
  @keyframes kenburns {
    0%   { transform: scale(1.08) translateX(0px); }
    50%  { transform: scale(1.14) translateX(-12px); }
    100% { transform: scale(1.08) translateX(0px); }
  }
  .banner-kenburns { animation: kenburns 14s ease-in-out infinite; }

  /* ── Reveal de tarjetas al scroll ────────────────────────────── */
  .jd-card {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.55s cubic-bezier(0.16,1,0.3,1),
                transform 0.55s cubic-bezier(0.16,1,0.3,1),
                box-shadow 0.25s ease,
                border-color 0.25s ease;
  }
  .jd-card.is-visible { opacity: 1; transform: translateY(0); }

  /* ── Hover en tarjetas ───────────────────────────────────────── */
  .jd-card:hover {
    box-shadow: 0 8px 32px rgba(0,0,0,0.12);
    transform: translateY(-3px) !important;
  }
  .jd-card:hover .jd-card-border { opacity: 1 !important; }

  /* ── Reveal de badges de generación ─────────────────────────── */
  .gen-badge {
    opacity: 0;
    transform: translateY(-10px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .gen-badge.is-visible { opacity: 1; transform: translateY(0); }

  /* ── Dibujo animado de conectores SVG ────────────────────────── */
  .jd-connector-path {
    stroke-dasharray: 2000;
    stroke-dashoffset: 2000;
    transition: stroke-dashoffset 1.4s cubic-bezier(0.4,0,0.2,1);
  }
  .jd-connector-path.is-drawn { stroke-dashoffset: 0; }

  /* ── Shimmer dorado en línea del conector ────────────────────── */
  @keyframes connector-glow {
    0%,100% { opacity: 0.35; }
    50%     { opacity: 0.7;  }
  }
  .jd-connector-path.is-drawn {
    animation: connector-glow 3s ease-in-out infinite;
  }
</style>

<Layout title="Junta Directiva" description="Cuatro generaciones de la familia COHONDUCAFE — desde los fundadores hasta la nueva generación.">

  <!-- PAGE HEADER -->
  <section class="relative h-80 flex items-end overflow-hidden">
    <img src="/img/Nosotros/BannerPrincipal/Familia.webp" alt="Junta Directiva"
         class="absolute inset-0 w-full h-full object-cover banner-kenburns" />
    <div class="absolute inset-0 bg-gradient-to-t from-forest-dark via-forest-dark/60 to-transparent"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-12 pb-12 w-full">
      <p data-i18n="jd.header.label" class="section-label mb-2">Empresa familiar</p>
      <h1 data-i18n="jd.header.h1" class="font-display text-5xl md:text-6xl font-bold text-white">Junta Directiva</h1>
    </div>
  </section>

  <!-- ── ÁRBOL GENERACIONAL HORIZONTAL ─────────────────────────────── -->
  <section class="bg-cream py-16 xl:py-20 overflow-hidden relative">
    <!-- Deco: oval girando superior derecha (fuera del scroll horizontal) -->
    <div class="absolute -right-20 -top-20 w-80 h-80 pointer-events-none select-none opacity-[0.06] vec-spin" aria-hidden="true">
      <img loading="lazy" decoding="async" src="/svg/oval.svg" alt="" class="w-full h-full" style="filter:sepia(1) saturate(0.35);" />
    </div>
    <!-- Deco: coffee flotando izquierda -->
    <div class="absolute -left-14 bottom-8 w-44 h-56 pointer-events-none select-none opacity-[0.05] vec-float" aria-hidden="true">
      <img loading="lazy" decoding="async" src="/svg/coffee.svg" alt="" class="w-full h-full" style="filter:sepia(1) saturate(0.4);" />
    </div>
    <!-- Deco: pen derivando centro superior -->
    <div class="absolute left-1/2 top-6 w-9 h-14 pointer-events-none select-none opacity-[0.07] vec-drift" aria-hidden="true">
      <img loading="lazy" decoding="async" src="/svg/pen.svg" alt="" class="w-full h-full" style="filter:sepia(1) saturate(0.5);" />
    </div>
    <!-- Árbol horizontal: solo en pantallas anchas (≥1280px) -->
    <div class="hidden xl:block max-w-7xl mx-auto px-6 lg:px-12">

      <!-- Etiquetas de generación (encima de cada columna) -->
      <div class="flex mb-6" style="align-items:flex-end;">
        {directivos.map((gen, i) => (
          <>
            <div class="flex-1 min-w-0 flex flex-col items-center gap-1">
              <p data-i18n={`jd.gen${i}.sub`} class="text-xs tracking-widest uppercase font-semibold" style={`color:${gen.color};`}>{gen.sub}</p>
              <div class="gen-badge text-xs font-bold tracking-widest uppercase px-3 py-1 text-white w-full text-center"
                   style={`background:${gen.color}; transition-delay:${i * 0.12}s`}>
                <span data-i18n={`jd.gen${i}.gen`}>{gen.gen}</span> · <span class="normal-case">{gen.year}</span>
              </div>
            </div>
            {i < directivos.length - 1 && (
              <div style={`width:${CONN_W}px; flex-shrink:0;`}></div>
            )}
          </>
        ))}
      </div>

      <!-- Árbol: columnas + conectores SVG alineados -->
      <div class="flex" style={`align-items:flex-start; height:${maxH}px;`}>

        {directivos.map((gen, i) => {
          const centers = getCenters(gen.miembros.length);
          const colH    = gen.miembros.length * CARD_H + (gen.miembros.length - 1) * CARD_G;
          const offset  = (maxH - colH) / 2;
          return (
            <>
              <!-- Columna de tarjetas, centrada verticalmente -->
              <div class="flex-1 min-w-0 flex flex-col relative" style={`gap:${CARD_G}px; margin-top:${offset}px;`}>
                {gen.miembros.map(m => (
                  <div class="jd-card bg-white cursor-pointer"
                       {...cardAttrs(m, gen)}
                       style={`height:${CARD_H}px; border:1px solid ${gen.color}20; border-left:3px solid ${gen.color}; overflow:hidden; transition-delay:${(i * 0.15 + gen.miembros.indexOf(m) * 0.1)}s`}>

                    {m.nombre2 ? (
                      /* ── Tarjeta doble (pareja) ── */
                      <div class="flex h-full">
                        <div class="shrink-0 flex items-center justify-center h-full overflow-hidden"
                             style={`width:${IMG_W}px; background:${gen.color}08; border-right:1px dashed ${gen.color}25;`}>
                          {m.img2
                            ? <img loading="lazy" decoding="async" src={m.img2} alt={`${m.nombre} y ${m.nombre2}`} class="w-full h-full object-cover" />
                            : <svg class="w-10 h-10 opacity-20" fill="none" stroke="currentColor" stroke-width="1.2" viewBox="0 0 24 24" style={`color:${gen.color};`}>
                                <circle cx="9" cy="7" r="3.5"/><path stroke-linecap="round" d="M2 19c0-3.5 3-6 7-6"/>
                                <circle cx="16" cy="7" r="3.5"/><path stroke-linecap="round" d="M10 19c0-3.5 3-6 7-6s7 2.5 7 6"/>
                              </svg>
                          }
                        </div>
                        <div class="flex flex-col justify-center px-3 gap-2 min-w-0">
                          <div class="min-w-0">
                            <p class="font-display font-bold text-coffee-dark text-xs leading-tight">{m.nombre}</p>
                            <p class="text-xs font-medium" style={`color:${gen.color};`}>{m.cargo}</p>
                          </div>
                          <div class="w-full h-px" style={`background:${gen.color}20;`}></div>
                          <div class="min-w-0">
                            <p class="font-display font-bold text-coffee-dark text-xs leading-tight">{m.nombre2}</p>
                            <p class="text-xs font-medium" style={`color:${gen.color};`}>{m.cargo2}</p>
                          </div>
                        </div>
                      </div>
                    ) : (
                      /* ── Tarjeta simple ── */
                      <div class="flex h-full">
                        <div class="shrink-0 flex items-center justify-center h-full overflow-hidden"
                             style={`width:${IMG_W}px; background:${gen.color}08; border-right:1px dashed ${gen.color}25;`}>
                          {m.img
                            ? <img loading="lazy" decoding="async" src={m.img} alt={m.nombre} class="w-full h-full object-cover" />
                            : <svg class="w-9 h-9 opacity-20" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" style={`color:${gen.color};`}>
                                <circle cx="12" cy="8" r="4"/>
                                <path stroke-linecap="round" d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
                              </svg>
                          }
                        </div>
                        <div class="flex flex-col justify-center px-3 min-w-0">
                          <p class="font-display font-bold text-coffee-dark text-sm leading-tight">{m.nombre}</p>
                          <p class="text-xs mt-0.5 font-medium leading-snug" style={`color:${gen.color};`}>{m.cargo}</p>
                          {m.detalle && <p class="text-coffee/85 text-xs mt-1 italic leading-snug">{m.detalle}</p>}
                        </div>
                      </div>
                    )}

                  </div>
                ))}
              </div>

              <!-- Conector SVG entre esta generación y la siguiente -->
              {i < directivos.length - 1 && (
                <svg
                  width={connectors[i].w}
                  height={connectors[i].h}
                  style={`flex-shrink:0; overflow:visible;`}
                  aria-hidden="true"
                >
                  <path d={connectors[i].d} fill="none" stroke="#C49A3C" stroke-width="1.5" class="jd-connector-path"/>
                </svg>
              )}
            </>
          );
        })}

      </div>
    </div>

    <!-- Lista por generación: tablet y móvil (<1280px) -->
    <div class="xl:hidden max-w-3xl mx-auto px-6 relative">
      {directivos.map((gen, i) => (
        <div class={i < directivos.length - 1 ? 'pb-10 mb-10 border-b border-gold/20' : ''}>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-4">
            <span class="gen-badge text-xs font-bold tracking-widest uppercase px-3 py-1 text-white"
                  style={`background:${gen.color};`}>
              <span data-i18n={`jd.gen${i}.gen`}>{gen.gen}</span> · <span class="normal-case">{gen.year}</span>
            </span>
            <span data-i18n={`jd.gen${i}.sub`} class="text-xs tracking-widest uppercase font-semibold" style={`color:${gen.color};`}>{gen.sub}</span>
          </div>
          <div class="grid sm:grid-cols-2 gap-3">
            {gen.miembros.map((m: Miembro) => (
              <div class="jd-card bg-white cursor-pointer flex"
                   {...cardAttrs(m, gen)}
                   style={`border:1px solid ${gen.color}20; border-left:3px solid ${gen.color};`}>
                <div class="shrink-0 w-24 self-stretch min-h-[7rem] overflow-hidden" style={`background:${gen.color}08;`}>
                  {(m.nombre2 ? m.img2 : m.img) &&
                    <img loading="lazy" decoding="async" src={m.nombre2 ? m.img2 : m.img}
                         alt={m.nombre2 ? `${m.nombre} y ${m.nombre2}` : m.nombre} class="w-full h-full object-cover" />}
                </div>
                <div class="flex flex-col justify-center gap-2 px-4 py-3 min-w-0">
                  <div>
                    <p class="font-display font-bold text-coffee-dark text-base leading-tight">{m.nombre}</p>
                    <p class="text-xs mt-0.5 font-medium leading-snug" style={`color:${gen.color};`}>{m.cargo}</p>
                    {m.detalle && <p class="text-coffee/85 text-xs mt-1 italic leading-snug">{m.detalle}</p>}
                  </div>
                  {m.nombre2 && (
                    <div>
                      <p class="font-display font-bold text-coffee-dark text-base leading-tight">{m.nombre2}</p>
                      <p class="text-xs mt-0.5 font-medium leading-snug" style={`color:${gen.color};`}>{m.cargo2}</p>
                    </div>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ─── CTA ───────────────────────────────────────────────────── -->
  <section class="py-20 bg-[#1C0E08] text-center relative overflow-hidden">
    <!-- Deco: oval-alt girando centro -->
    <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[440px] h-[440px] pointer-events-none select-none opacity-[0.04] vec-spin-rev" aria-hidden="true">
      <img loading="lazy" decoding="async" src="/svg/oval-alt.svg" alt="" class="w-full h-full brightness-200" />
    </div>
    <!-- Deco: coffee flotando inferior derecha -->
    <div class="absolute -right-10 bottom-0 w-40 h-52 pointer-events-none select-none opacity-[0.06] vec-float-rev" aria-hidden="true">
      <img loading="lazy" decoding="async" src="/svg/coffee.svg" alt="" class="w-full h-full brightness-200" />
    </div>
    <!-- Deco: benefit02 flotando izquierda -->
    <div class="absolute left-[6%] top-8 w-12 h-12 pointer-events-none select-none opacity-[0.08] vec-pulse" aria-hidden="true">
      <img loading="lazy" decoding="async" src="/svg/benefit02.svg" alt="" class="w-full h-full brightness-200" />
    </div>
    <div class="max-w-xl mx-auto px-6 relative z-10">
      <p data-i18n="jd.cta.label" class="section-label mb-4">¿Hablamos?</p>
      <h2 data-i18n="jd.cta.h2" class="font-display text-4xl font-bold text-white mb-6">Conecta con nosotros</h2>
      <p data-i18n="jd.cta.para" class="text-cream/70 mb-8 leading-relaxed">Si eres importador, tostador o distribuidor y quieres conocer más sobre nuestra empresa.</p>
      <a href="/contacto" class="btn-primary"><span data-i18n="jd.cta.btn">Escríbenos</span></a>
    </div>
  </section>

  <!-- ── MODAL DE BIODATA ──────────────────────────────────────────── -->
  <div id="jd-overlay"
       role="dialog" aria-modal="true" aria-labelledby="jd-modal-nombre" aria-hidden="true"
       class="fixed inset-0 z-[60] flex items-center justify-center px-4"
       style="background:rgba(15,8,4,0.75); backdrop-filter:blur(6px); opacity:0; pointer-events:none; transition: opacity 0.3s ease;">

    <div id="jd-modal"
         class="relative bg-cream w-full max-w-xl rounded-sm shadow-2xl overflow-hidden max-h-[90vh] flex flex-col"
         style="transform: scale(0.94) translateY(16px); transition: transform 0.35s cubic-bezier(0.16,1,0.3,1);">

      <!-- Barra de color generacional -->
      <div id="jd-modal-bar" class="h-1.5 w-full"></div>

      <!-- Botón cerrar -->
      <button id="jd-modal-close"
              class="absolute top-4 right-4 text-coffee/85 hover:text-coffee transition-colors duration-200 z-10"
              aria-label="Cerrar" data-i18n-aria="a11y.close">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>

      <!-- Foto + nombre -->
      <div class="flex items-center gap-5 px-7 pt-7 pb-5">
        <div id="jd-modal-img-wrap"
             class="w-24 h-24 rounded-full overflow-hidden shrink-0 border-2"
             style="border-color:#C49A3C30;">
          <img id="jd-modal-img" src="" alt="" class="w-full h-full object-cover hidden"/>
          <div id="jd-modal-img-ph" class="w-full h-full flex items-center justify-center" style="background:#C49A3C10;">
            <svg class="w-8 h-8 opacity-25" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <circle cx="12" cy="8" r="4"/><path stroke-linecap="round" d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
            </svg>
          </div>
        </div>
        <div>
          <h3 id="jd-modal-nombre" class="font-display font-bold text-coffee-dark text-lg leading-tight"></h3>
          <p  id="jd-modal-cargo"  class="text-xs font-semibold tracking-wide mt-1 leading-snug"></p>
        </div>
      </div>

      <!-- Separador -->
      <div id="jd-modal-sep" class="mx-7 h-px" style="background:#C49A3C20;"></div>

      <!-- Bio y pills -->
      <div class="px-7 py-5 flex flex-col gap-5">
        <div>
          <p data-i18n="jd.modal.bio" class="text-xs font-bold tracking-[0.3em] uppercase text-coffee/85 mb-2">Biografía</p>
          <p id="jd-modal-bio" class="text-coffee/85 text-sm leading-relaxed"></p>
        </div>
        <div>
          <p data-i18n="jd.modal.profile" class="text-xs font-bold tracking-[0.3em] uppercase text-coffee/85 mb-3">Perfil</p>
          <div id="jd-modal-pills" class="flex flex-wrap gap-2"></div>
        </div>
      </div>

    </div>
  </div>

  <script is:inline>
  (function () {
    /* ── Reveal por scroll ──────────────────────────────────────── */
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        var el = e.target;
        if (el.classList.contains('jd-card'))           el.classList.add('is-visible');
        if (el.classList.contains('gen-badge'))         el.classList.add('is-visible');
        if (el.classList.contains('jd-connector-path')) el.classList.add('is-drawn');
        io.unobserve(el);
      });
    }, { threshold: 0.15 });
    document.querySelectorAll('.jd-card, .gen-badge, .jd-connector-path')
      .forEach(function (el) { io.observe(el); });

    /* ── Modal ──────────────────────────────────────────────────── */
    var overlay  = document.getElementById('jd-overlay');
    var modal    = document.getElementById('jd-modal');
    var bar      = document.getElementById('jd-modal-bar');
    var sep      = document.getElementById('jd-modal-sep');
    var imgEl    = document.getElementById('jd-modal-img');
    var imgWrap  = document.getElementById('jd-modal-img-wrap');
    var imgPh    = document.getElementById('jd-modal-img-ph');
    var nombreEl = document.getElementById('jd-modal-nombre');
    var cargoEl  = document.getElementById('jd-modal-cargo');
    var bioEl    = document.getElementById('jd-modal-bio');
    var pillsEl  = document.getElementById('jd-modal-pills');
    var closeBtn = document.getElementById('jd-modal-close');

    function openModal(card) {
      var nombre = card.dataset.nombre || '';
      var cargo  = card.dataset.cargo  || '';
      var bio    = card.dataset.bio    || '';
      var pills  = card.dataset.pills  ? card.dataset.pills.split('||') : [];
      var color  = card.dataset.color  || '#C49A3C';
      var img    = card.dataset.img    || '';

      bar.style.background      = color;
      sep.style.background      = color + '25';
      imgWrap.style.borderColor = color + '50';
      cargoEl.style.color       = color;

      if (img) {
        imgEl.src = img; imgEl.classList.remove('hidden');
        imgPh.classList.add('hidden');
      } else {
        imgEl.classList.add('hidden');
        imgPh.classList.remove('hidden');
        imgPh.style.background = color + '12';
      }

      nombreEl.textContent = nombre;
      cargoEl.textContent  = cargo;

      /* Renderizar bio con párrafos */
      bioEl.innerHTML = '';
      bio.split('\n\n').forEach(function (para) {
        if (!para.trim()) return;
        var p = document.createElement('p');
        /* Detectar cita (empieza con ") para darle estilo especial */
        if (para.trim().startsWith('"')) {
          p.style.cssText = 'font-style:italic; font-size:0.8rem; color:var(--color-coffee,#3E2410); opacity:0.75; border-left:3px solid currentColor; padding-left:12px; margin-top:8px;';
          p.style.borderColor = cargoEl.style.color;
        } else {
          p.style.cssText = 'font-size:0.82rem; line-height:1.7; color:rgba(62,36,16,0.65); margin-bottom:4px;';
        }
        p.textContent = para.trim();
        bioEl.appendChild(p);
      });

      pillsEl.innerHTML = '';
      pills.forEach(function (p) {
        var s = document.createElement('span');
        s.textContent = p;
        s.style.cssText = 'background:' + color + ';color:#fff;font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;padding:4px 12px;border-radius:999px;';
        pillsEl.appendChild(s);
      });

      overlay.style.opacity       = '1';
      overlay.style.pointerEvents = 'auto';
      overlay.setAttribute('aria-hidden', 'false');
      modal.style.transform       = 'scale(1) translateY(0)';
      document.body.style.overflow = 'hidden';
      lastCard = card;
      closeBtn.focus();
    }

    var lastCard = null;
    function closeModal() {
      if (overlay.getAttribute('aria-hidden') === 'true') return;
      overlay.style.opacity       = '0';
      overlay.style.pointerEvents = 'none';
      overlay.setAttribute('aria-hidden', 'true');
      modal.style.transform       = 'scale(0.94) translateY(16px)';
      document.body.style.overflow = '';
      if (lastCard) lastCard.focus();
    }

    document.querySelectorAll('.jd-card[data-bio]').forEach(function (card) {
      if (!card.dataset.bio) return;
      card.addEventListener('click', function () { openModal(card); });
      card.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openModal(card); }
      });
    });

    closeBtn.addEventListener('click', closeModal);
    overlay.addEventListener('click', function (e) {
      if (e.target === overlay) closeModal();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeModal();
      /* Mantener el foco dentro del modal mientras está abierto (solo hay un control) */
      if (e.key === 'Tab' && overlay.getAttribute('aria-hidden') === 'false') {
        e.preventDefault();
        closeBtn.focus();
      }
    });
  })();
  </script>

</Layout>
