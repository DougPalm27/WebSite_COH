<script is:inline>
// Nav sticky: resalta el tab de la marca visible
(function () {
  var tabs = document.querySelectorAll('.marcas-tab');
  var sections = document.querySelectorAll('section[id]');

  function setActive(id) {
    tabs.forEach(function (t) {
      var isActive = t.dataset.tab === id;
      t.style.color = isActive ? 'rgba(255,255,255,0.95)' : '';
      var line = t.querySelector('.marcas-tab-line');
      if (line) line.style.transform = isActive ? 'scaleX(1)' : 'scaleX(0)';
    });
  }

  var observer = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) setActive(entry.target.id);
    });
  }, { threshold: 0.3 });

  sections.forEach(function (s) {
    if (['hosco','minahonda','fundacion'].includes(s.id)) observer.observe(s);
  });

  // Smooth scroll en tabs
  tabs.forEach(function (tab) {
    tab.addEventListener('click', function (e) {
      e.preventDefault();
      var target = document.getElementById(tab.dataset.tab);
      if (target) target.scrollIntoView({ behavior: 'smooth' });
    });
  });
})();
</script>
